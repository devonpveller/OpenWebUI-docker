{
  "name": "system-orchestrator",
  "version": "1.0.0",
  "description": "System-wide orchestrator for comprehensive health monitoring across all modules",
  "type": "orchestration",
  "category": "system-management",
  "capabilities": [
    "comprehensive_health_check",
    "module_coordination", 
    "system_overview",
    "cross_module_testing",
    "health_aggregation"
  ],
  "resources": {
    "cpu": "medium",
    "memory": "medium",
    "io": "medium",
    "network": false
  },
  "configuration": {
    "timeout_seconds": 60,
    "max_retries": 1,
    "cache_enabled": false
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "request_id": {"type": "string"},
      "input": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "properties": {
              "check_type": {"type": "string", "enum": ["comprehensive", "quick", "specific_module"]},
              "modules": {"type": "array", "items": {"type": "string"}},
              "detailed": {"type": "boolean"}
            }
          }
        ]
      }
    },
    "required": ["request_id", "input"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": {"type": "string"},
      "module_id": {"type": "string"},
      "status": {"type": "string", "enum": ["ok", "error"]},
      "content": {"type": "string"},
      "structured_data": {
        "type": "object",
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "total_modules": {"type": "integer"},
          "modules_healthy": {"type": "integer"},
          "modules_degraded": {"type": "integer"},
          "modules_failed": {"type": "integer"},
          "overall_status": {"type": "string"},
          "overall_health_score": {"type": "integer"},
          "module_results": {"type": "object"},
          "summary": {"type": "object"},
          "recommendations": {"type": "array", "items": {"type": "string"}}
        }
      },
      "diagnostics": {
        "type": "object",
        "properties": {
          "execution_time_ms": {"type": "integer"},
          "orchestrator_version": {"type": "string"}
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "retriable": {"type": "boolean"}
        }
      },
      "timestamp": {"type": "string", "format": "date-time"}
    },
    "required": ["request_id", "module_id", "status", "content", "timestamp"]
  },
  "examples": [
    {
      "description": "Comprehensive system health check",
      "input": {
        "request_id": "orchestrator-001",
        "input": "comprehensive health check"
      },
      "output": {
        "request_id": "orchestrator-001", 
        "module_id": "system-orchestrator",
        "status": "ok",
        "content": "## 🏥 Comprehensive System Health Report\n\n**Overall Status**: 🟢 Excellent (95/100)",
        "structured_data": {
          "total_modules": 4,
          "modules_healthy": 4,
          "overall_status": "excellent",
          "overall_health_score": 95
        },
        "diagnostics": {
          "execution_time_ms": 1500,
          "orchestrator_version": "1.0.0"
        },
        "timestamp": "2024-01-01T12:00:00Z"
      }
    }
  ],
  "dependencies": {
    "python": ">=3.8",
    "packages": []
  },
  "health_checks": [
    {
      "name": "modules_directory_accessible",
      "description": "Verify modules directory is accessible",
      "critical": true
    },
    {
      "name": "python_executable_working", 
      "description": "Verify Python executable is functional",
      "critical": true
    },
    {
      "name": "module_discovery",
      "description": "Test ability to discover available modules",
      "critical": false
    }
  ],
  "observability": {
    "logs": {
      "level": "INFO",
      "include_request_id": true,
      "include_execution_time": true
    },
    "metrics": [
      "health_checks_total",
      "modules_tested_total", 
      "modules_healthy_total",
      "modules_failed_total",
      "execution_time_seconds"
    ]
  },
  "security": {
    "permissions": ["read", "execute"],
    "sandboxing": false,
    "resource_limits": {
      "max_memory_mb": 256,
      "max_cpu_percent": 50,
      "max_execution_time_seconds": 60
    }
  },
  "routing": {
    "keywords": ["overall health", "system status", "comprehensive check", "all modules", "orchestrator"],
    "patterns": [
      "overall*health*",
      "comprehensive*",
      "system*status*",
      "all*modules*",
      "*orchestrat*"
    ],
    "priority": 0
  },
  "maintainer": {
    "name": "AI Stack Development Team",
    "created_at": "2024-01-01T12:00:00Z",
    "purpose": "Comprehensive system health coordination across all modules"
  }
}