OPEN_WEBUI_HOST=openwebui

# GPU Device Mapping
# Use: nvidia-smi --query-gpu=index,name --format=csv
# Set by index (0, 1, ...) or GPU UUID (GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
GPU_LLAMA_CPP_DEVICE_ID=0
GPU_LLAMA_CPP_EMBED_DEVICE_ID=1
GPU_AISTACK_DEVICE_ID=1

# llama.swap model defaults for llama-cpp service
# Select model via request model id: qwen36-35b-a3b or qwen36-27b
LLAMA_CPP_CTX_SIZE=262144
LLAMA_CPP_CACHE_TYPE_K=q4_0
LLAMA_CPP_CACHE_TYPE_V=q4_0
LLAMA_CPP_BATCH=1024
LLAMA_CPP_UBATCH=512
LLAMA_CPP_TIMEOUT=300

# Qwen 3.6 35B-A3B profile (currently active)
LLAMA_SWAP_QWEN36_35B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_35B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_35B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_35B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_35B_BATCH=1024
LLAMA_SWAP_QWEN36_35B_UBATCH=512
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_35B_REASONING_BUDGET=4096

# Qwen 3.6 27B profile (download model and adjust path if needed)
LLAMA_SWAP_QWEN36_27B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-27B-GGUF/Qwen3.6-27B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_27B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_27B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_27B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_27B_BATCH=1024
LLAMA_SWAP_QWEN36_27B_UBATCH=512
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_27B_REASONING_BUDGET=4096

# Mnemory should stay below the server context to preserve prompt/output headroom.
MNEMORY_LLM_CONTEXT_SIZE=131072

# key expires Aug 28 2025
# create a new one here: 
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=putyourtskeyhere


# Mnemory Memory Service
# API key for MCP authentication (single key)
MCP_API_KEY=your-mnemory-api-key-here
# JSON dict mapping keys to user IDs: {"api-key": "user-id"}
MCP_API_KEYS=
# Backup retention -- how many MOST-RECENT archives to keep (count, not days).
# Default 2 = ~2 nightly snapshots local; the weekly NAS sync gives you
# ~2 additional copies per NAS slot.
BACKUP_RETAIN_COUNT=2
# Backup cron schedule (default: daily at 2 AM)
BACKUP_CRON=0 2 * * *
# OpenWebUI backup retention count (default 2 most recent)
OPENWEBUI_BACKUP_RETAIN_COUNT=2
# OpenWebUI backup cron schedule (default: daily at 2 AM)
OPENWEBUI_BACKUP_CRON=0 2 * * *

# GPU routing for llama-cpp and aistack services
GPU_AISTACK_DEVICE_ID=1
GPU_LLAMA_CPP_DEVICE_ID=0
GPU_LLAMA_CPP_EMBED_DEVICE_ID=1

# ---------------------------------------------------------------------------
# Private Search Gateway (privacy-first web search over Tor)
# Plan: documentation/web-search/integration-plan-private-search-gateway.md
# ---------------------------------------------------------------------------
# REQUIRED — generate long random strings (e.g. `openssl rand -hex 32`):
GATEWAY_API_KEY=change-me-to-a-long-random-string
SEARXNG_SECRET_KEY=change-me-to-another-long-random-string

# Gateway behaviour (defaults are sensible; override only if needed)
PROVIDER_PRIORITY=searxng
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=120
LOG_LEVEL=INFO
LOG_QUERIES=false                 # PRIVACY: keep false; true logs only a hash

# Pin images for reproducible privacy infra (replace :latest after first pull)
SEARXNG_IMAGE=searxng/searxng:latest
SEARCH_REDIS_IMAGE=redis:7-alpine
TOR_IMAGE=osminogin/tor-simple:latest

# Open WebUI web-search wiring (Approach B — stock searxng engine → gateway).
# This also drives smolcrawl deep_research (it calls OWUI's search_web()).
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://gateway:8080/search?q=<query>

# ---------------------------------------------------------------------------
# open-terminal — workspace plane API key (used by OWUI and, from Tool, by
# little-coder). Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
OPEN_TERMINAL_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# little-coder — self-improving coding agent (Chapter 1: Tool)
# Docs: documentation/little-coder/
# ---------------------------------------------------------------------------
# Pin the upstream little-coder version for reproducible builds (plan §5).
# Pin a concrete version — never `latest` (it floats; a rebuild silently jumps).
LITTLE_CODER_VERSION=1.9.7

# Route the agent's command execution into open-terminal via the bash-override
# pi extension (design §3.4). 1 = route to open-terminal (default, verified);
# 0 = built-in bash, runs in the network-isolated little-coder container.
# See little-coder/pi-extension/README.md.
LC_ROUTE_EXEC=1

# llama-cpp API key for the agent's inference (llama-swap accepts any value).
LC_LLAMA_API_KEY=llama


# Per-repo deploy token for cloning private work repos (design §10.3):
# least-privilege, HTTPS token, never the self-improvement PAT. Empty = public.
LC_DEPLOY_TOKEN=

# Backup retention + schedule for the little-coder expertise volumes.
LC_BACKUP_RETAIN_COUNT=2
LC_BACKUP_CRON=0 2 * * *

# OPERATOR ACTION ITEMS — required before the self-improvement chapters.
# Unused in Tool; wire them now so later chapters do not retrofit the chain.
#   1. Create a PRIVATE self-improvement git remote (design §10.6).
#   2. Provision a fine-grained PAT scoped to contents:write on it ONLY —
#      no repo deletion, no admin, no other repos.
# Also: add your git remote's host to little-coder/docker/egress-allowlist.txt.
LC_SELF_REMOTE_URL=
LC_SELF_REMOTE_PAT=

# === Internet-exposed front-end (portal) ===
# See documentation/implementation-guide/open-source authentication front ends for ai stack/
# Plan §8 Step 8. The portal is gated behind compose profile `internet`, so
# nothing here takes effect until `scripts/portal-on.ps1` is run.

PUBLIC_DOMAIN=ai.example.com
ACME_EMAIL=you@example.com

# Cloudflare Tunnel — required (port-forward mode removed from the plan).
# Create the tunnel in Cloudflare Zero Trust dashboard, paste token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Authelia secrets — generate each with:
#   docker run --rm authelia/authelia:4.39 authelia crypto rand --length 64
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# === Portal-alerter (Gmail self-send via reused OB1 OAuth client) ===
# DIGEST_TO is where alerts AND scheduled digests land. Use your own Gmail.
# DIGEST_FROM defaults to DIGEST_TO if blank; should match the Google account
# that consented to the open-brain-email OAuth client.
DIGEST_TO=
DIGEST_FROM=
DIGEST_WINDOW_HOURS=24

# Rate-limit on instant /alert emails (per rolling minute). Excess events
# in the same minute are coalesced into one summary email at minute close.
ALERT_RATE_LIMIT_PER_MIN=20

# Scheduled digest cadence (cron in UTC). Default = daily 07:00 UTC.
PORTAL_DIGEST_CRON=0 7 * * *

# Integrity tripwire schedule (cron in UTC).
TRIPWIRE_CRON=0 4 * * *

# Cloudflare-tunnel liveness probe. Polls /ready endpoint and alerts
# after FAILURES_BEFORE_ALERT consecutive failures.
TUNNEL_WATCHER_POLL_SEC=30
TUNNEL_WATCHER_FAILURES_BEFORE_ALERT=3

# SurrealDB credentials (pre-flight §6.3)
SURREAL_USER=
SURREAL_PASSWORD=

# Open Notebook DB encryption key (pre-flight §6.4)
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Backup retention for portal volumes (count of most-recent archives kept)
CADDY_BACKUP_RETAIN_COUNT=2
CADDY_BACKUP_CRON=0 3 * * *
AUTHELIA_BACKUP_RETAIN_COUNT=2
AUTHELIA_BACKUP_CRON=0 3 * * *

# === Unified snapshot — additional backup containers (Part 1 of the
# yes-its-working-now-soft-candy plan) ===
# See: documentation/runbooks/backup-conventions.md + documentation/runbooks/restore-from-snapshot.md
# Scripts: scripts/check-backup-coverage.ps1, scripts/restore-from-snapshot.ps1
#
# All *_BACKUP_RETAIN_COUNT vars are COUNTS (how many most-recent archives
# to keep), not days. Default 2 -- you also get up to 2 more copies via the
# two-slot weekly NAS rotation, for ~6 total copies per service.
#
# All backup scripts run a PRECHECK before they touch any file. They skip
# silently (and log) if the source data is empty/missing or, where
# applicable, if a TCP health probe to the source service fails. This
# prevents capturing a torn snapshot when a service is broken.

# OB1 PostgreSQL nightly logical dump (pg_dump -Fc, pgvector-preserving).
# Pull these from OB1/docker/.env -- they MUST match what openbrain-db is
# running with, else the dump fails auth.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=openbrain
OPENBRAIN_DB_BACKUP_RETAIN_COUNT=2
OPENBRAIN_DB_BACKUP_CRON=0 2 * * *

# OB1 wiki (immutable git objects -- hot tar is safe).
OPENBRAIN_WIKI_BACKUP_RETAIN_COUNT=2
OPENBRAIN_WIKI_BACKUP_CRON=15 2 * * *

# Open Notebook: surreal export (logical) + notebook_data tar.
# Backup container connects to surrealdb as root/root by convention; see
# documentation/runbooks/restore-from-snapshot.md.
OPEN_NOTEBOOK_BACKUP_RETAIN_COUNT=2
OPEN_NOTEBOOK_BACKUP_CRON=20 2 * * *

# Smolcrawl pipelines volume + Tailscale state bind mount.
SMOLCRAWL_BACKUP_RETAIN_COUNT=2
SMOLCRAWL_BACKUP_CRON=25 2 * * *
TAILSCALE_BACKUP_RETAIN_COUNT=2
TAILSCALE_BACKUP_CRON=25 2 * * *

# LM Studio models (~110GB at present). Weekly cadence so two NAS slots
# = ~220GB max. Set LM_MODELS_BACKUP_CRON= (empty) to DISABLE this backup
# if NAS storage becomes the bottleneck.
LM_MODELS_BACKUP_RETAIN_COUNT=2
LM_MODELS_BACKUP_CRON=0 1 * * 0

# ---------------------------------------------------------------------------
# LiteLLM gateway — transparent interposition (guide §1A, added 2026-06-12)
# Docs: documentation/implementation-guide/LiteLLM-Proxy/guide-LiteLLM-Proxy.md
# ---------------------------------------------------------------------------
# Internal Postgres password for llm-gateway-db (reachable only on the internal
# llm-net). Generate: a long random hex string. Real value lives in .env (gitignored).
LITELLM_DB_PASSWORD=change-me-to-a-long-random-string
# Spend-log backup retention + schedule (non-authoritative telemetry DB).
LITELLM_BACKUP_RETAIN_DAYS=7
LITELLM_BACKUP_CRON=0 2 * * *
# NOTE: the gateway runs PERMISSIVE (no LITELLM_MASTER_KEY) during the lazy-key
# period — attribution is by the key string each caller sends (guide §1A.3/§1A.4).
# Only set a master key at the end-state when enforcing virtual keys + caps.
# ============================================================================
# Added 2026-08-20 (CLEANUP-PLAN v3 A.4): the 58 compose-referenced vars that
# were missing from this template. Secrets are blank on purpose. Vars with a
# compose-side default (${VAR:-default}) list that default here.
# ============================================================================

# --- REQUIRED secrets (blank = fill in) -------------------------------------
# Encrypts values at rest in webui.db. Pin once; a rotate breaks every
# encrypted credential + all sessions.
WEBUI_SECRET_KEY=
# Mullvad WireGuard (search-plane engine egress)
MULLVAD_WG_PRIVATE_KEY=
MULLVAD_WG_ADDRESSES=
# LiteLLM Admin-UI sidecar (llm-gateway-ui, tailnet :8445/ui)
LITELLM_UI_MASTER_KEY=
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=
# mnemory privacy gateway (:8060)
MNEMORY_GATEWAY_KEY=
MNEMORY_CLOUD_USER=
# smolcrawl-pipelines API key (OWUI -> pipelines :9099)
SMOLCRAWL_API_KEY=
# Quartz workbench write API key
WORKBENCH_KEY=

# --- Search plane ------------------------------------------------------------
MULLVAD_COUNTRIES=Netherlands
VPN_IMAGE=qmcgaw/gluetun:latest
SEARCH_NET_SUBNET=172.16.0.0/12

# --- OpenWebUI feature flags --------------------------------------------------
ENABLE_CODE_INTERPRETER=False
ENABLE_CODE_EXECUTION=False

# --- llm-queue (B2 admission controller) --------------------------------------
LLM_QUEUE_SLOTS=3
LLM_QUEUE_MAX_IN_FLIGHT=4
LLM_QUEUE_ENFORCE_BUDGET=true
LLM_QUEUE_EVENTS_DB_PATH=/data/events.db
LLM_QUEUE_BACKSTOP_DEPTH=24
LLM_QUEUE_LOG_LEVEL=INFO
LLM_QUEUE_MAX_TOTAL_CONNECTIONS=128
LLM_QUEUE_T_INITIAL_S=30
LLM_QUEUE_T_WINDOW=5
LLM_QUEUE_UPSTREAM_TIMEOUT_S=600

# --- llama.cpp serve routes (tailscale entrypoint) -----------------------------
LLAMA_CPP_ENABLED=true
LLAMA_CPP_HOST=llama-cpp
LLAMA_CPP_PORT=8080
LLAMA_CPP_EMBED_ENABLED=true
LLAMA_CPP_EMBED_HOST=llama-cpp-embed
LLAMA_CPP_EMBED_PORT=8080
LLAMA_ARG_CTX_CHECKPOINTS=8

# --- llama-swap speculative decoding (qwen36-27b MTP) ---------------------------
LLAMA_SWAP_QWEN36_27B_SPEC_TYPE=draft-mtp
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_N_MAX=8
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_CACHE_TYPE_K=q8_0
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_CACHE_TYPE_V=q8_0

# --- open_notebook / Quartz serve routes ---------------------------------------
OPEN_NOTEBOOK_ENABLED=true
OPEN_NOTEBOOK_HOST=open_notebook
OPEN_NOTEBOOK_PORT=8502
OPEN_NOTEBOOK_TS_PORT=8443
OPEN_NOTEBOOK_API_PORT=5055
OPEN_NOTEBOOK_API_TS_PORT=5055
QUARTZ_ENABLED=true
QUARTZ_HOST=caddy
QUARTZ_PORT=8446
QUARTZ_TS_PORT=8444

# --- Backup sidecar knobs (generic-tar sidecars unless noted) --------------------
BACKUP_INTERVAL=86400
RETAIN_COUNT=2
MIN_AGE_SECS=82800
SMOLCRAWL_BACKUP_INTERVAL=86400
SMOLCRAWL_BACKUP_HEALTH_TCP=smolcrawl-pipelines:9099
TAILSCALE_BACKUP_INTERVAL=86400
LM_MODELS_BACKUP_INTERVAL=604800
LM_MODELS_BACKUP_MIN_AGE_SECS=43200
LM_MODELS_BACKUP_HEALTH_TCP=llama-cpp-upstream:8080
OPENBRAIN_WIKI_BACKUP_INTERVAL=86400
CADDY_BACKUP_HEALTH_TCP=caddy:80
AUTHELIA_BACKUP_HEALTH_TCP=authelia:9091
