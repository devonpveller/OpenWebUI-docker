OLLAMA_HOST=http://ollama:11434
OPEN_WEBUI_HOST=openwebui

# GPU Device Mapping
# Use: nvidia-smi --query-gpu=index,name --format=csv
# Set by index (0, 1, ...) or GPU UUID (GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
GPU_LLAMA_CPP_DEVICE_ID=0
GPU_LLAMA_CPP_EMBED_DEVICE_ID=1
GPU_AISTACK_DEVICE_ID=1

# llama.swap model defaults for llama-cpp service
# Select model via request model id: qwen36-35b-a3b or qwen36-27b
LLAMA_CPP_CTX_SIZE=262144
LLAMA_CPP_CACHE_TYPE_K=q4_0
LLAMA_CPP_CACHE_TYPE_V=q4_0
LLAMA_CPP_BATCH=1024
LLAMA_CPP_UBATCH=512
LLAMA_CPP_TIMEOUT=300

# Qwen 3.6 35B-A3B profile (currently active)
LLAMA_SWAP_QWEN36_35B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_35B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_35B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_35B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_35B_BATCH=1024
LLAMA_SWAP_QWEN36_35B_UBATCH=512
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_35B_REASONING_BUDGET=4096

# Qwen 3.6 27B profile (download model and adjust path if needed)
LLAMA_SWAP_QWEN36_27B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-27B-GGUF/Qwen3.6-27B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_27B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_27B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_27B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_27B_BATCH=1024
LLAMA_SWAP_QWEN36_27B_UBATCH=512
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_27B_REASONING_BUDGET=4096

# Mnemory should stay below the server context to preserve prompt/output headroom.
MNEMORY_LLM_CONTEXT_SIZE=131072

# key expires Aug 28 2025
# create a new one here: 
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=putyourtskeyhere

# LM Studio Configuration
# LM Studio server host (use specific IP if not localhost)
LMSTUDIO_HOST=host.docker.internal
# Default LM Studio server port (usually 1234)
LMSTUDIO_PORT=1234
# Set to true to enable LM Studio Tailscale serve configuration
LMSTUDIO_ENABLED=true

# Mnemory Memory Service
# API key for MCP authentication (single key)
MCP_API_KEY=your-mnemory-api-key-here
# JSON dict mapping keys to user IDs: {"api-key": "user-id"}
MCP_API_KEYS=
# Backup retention days (default: 7)
BACKUP_RETAIN_DAYS=7
# Backup cron schedule (default: daily at 2 AM)
BACKUP_CRON=0 2 * * *
# OpenWebUI backup retention days (default: 7)
OPENWEBUI_BACKUP_RETAIN_DAYS=7
# OpenWebUI backup cron schedule (default: daily at 2 AM)
OPENWEBUI_BACKUP_CRON=0 2 * * *

# GPU routing for llama-cpp and aistack services
GPU_AISTACK_DEVICE_ID=1
GPU_LLAMA_CPP_DEVICE_ID=0
GPU_LLAMA_CPP_EMBED_DEVICE_ID=1

# ---------------------------------------------------------------------------
# Private Search Gateway (privacy-first web search over Tor)
# Plan: documentation/web-search/integration-plan-private-search-gateway.md
# ---------------------------------------------------------------------------
# REQUIRED — generate long random strings (e.g. `openssl rand -hex 32`):
GATEWAY_API_KEY=change-me-to-a-long-random-string
SEARXNG_SECRET_KEY=change-me-to-another-long-random-string

# Gateway behaviour (defaults are sensible; override only if needed)
PROVIDER_PRIORITY=searxng
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=120
LOG_LEVEL=INFO
LOG_QUERIES=false                 # PRIVACY: keep false; true logs only a hash

# Pin images for reproducible privacy infra (replace :latest after first pull)
SEARXNG_IMAGE=searxng/searxng:latest
SEARCH_REDIS_IMAGE=redis:7-alpine
TOR_IMAGE=osminogin/tor-simple:latest

# Open WebUI web-search wiring (Approach B — stock searxng engine → gateway).
# This also drives smolcrawl deep_research (it calls OWUI's search_web()).
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://gateway:8080/search?q=<query>