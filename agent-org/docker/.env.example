# agent-org environment — COPY to agent-org/docker/.env and fill in.
# No secrets in git (README G-convention). Everything below is read by the compose file.

# ── Backups (nightly sidecars → repo-root ./backups/<name>/) ────────────────
# How many recent artifacts each sidecar keeps — the two pg_dump sidecars
# (agent-bridge-db-backup / mattermost-db-backup) and the two worker-journal tar
# sidecars (ao-worker-{1,2}-journals-backup).
AO_BACKUP_RETAIN_COUNT=7
# Cadence for the worker-journal tars. Profile-gated with the workers themselves, so
# these sidecars only run when `--profile workers` is up.
AO_JOURNALS_BACKUP_INTERVAL=86400

# ── Mattermost ──────────────────────────────────────────────────────────────
MM_DB_PASSWORD=change-me-mattermost-db
MATTERMOST_VERSION=11.7
# Set to the tailnet URL at P7.4 (operator). Loopback default for local bring-up.
MM_SITE_URL=http://localhost:8065

# ── agent-bridge ────────────────────────────────────────────────────────────
AO_DB_PASSWORD=change-me-bridge-db
# Bot access token for @pm/@bridge — created in Mattermost (System Console -> Integrations
# -> Bot Accounts) AFTER first boot (P0.2). Token via env only, never a file.
AO_MATTERMOST_BOT_TOKEN=
# Worker pool (P5). Fill when enabling `--profile workers`; must match the pool instances.
AO_MAX_CONCURRENT_WORKERS=1
AO_WORKER_INSTANCE_URLS=http://ao-worker-1:8090,http://ao-worker-2:8090
# The pool's OWN open-terminal API key (independent of the main stack). Any non-empty value;
# used by both ao-ot-N (API_KEY) and ao-worker-N (the daemon reads OPEN_TERMINAL_API_KEY).
AO_OPEN_TERMINAL_KEY=change-me-ao-ot-key

# ── Open Brain audit mirror (P6.2) — optional ───────────────────────────────
# Enablement is an OPS STEP, deliberately after a live smoke: the wire protocol is
# covered by tests (tests/test_openbrain_client.py) but nothing here proves the key is
# right or the server is up, so flipping this on is a decision, not a default.
AO_OPENBRAIN_MIRROR_ENABLED=false
# The FIRST-PARTY lane. openbrain-gateway is the CLOUD door: obnet-only, Bearer-auth and
# tool-allowlisted — agent-bridge (ao-net + llm-net) cannot resolve it, so the previous
# `openbrain-gateway:8061` value could never have worked. openbrain-mcp shares llm-net
# with the bridge and authenticates with x-brain-key.
AO_OPENBRAIN_URL=http://openbrain-mcp:8000
# The value of MCP_ACCESS_KEY from OB1/docker/.env (openbrain-mcp checks it as x-brain-key).
AO_OPENBRAIN_KEY=
# Agent-memory write paths (memory-plane PLAN §2). Both OFF by default: turning a write
# path on at deploy time is how the audit mirror above spent weeks enabled and failing
# while its code default said otherwise. Flip these deliberately, one at a time.
AO_MEMORY_WRITEBACK_ENABLED=false
AO_MEMORY_RECALL_ENABLED=false

# ── Comms model (channel = project, effort = thread) — defaults are safe ─────
AO_DEFAULT_PROJECT=sandbox
# The org works on ANY repo you onboard from Mattermost with `/project add <name> <repo-url>`
# (creates #proj-<name> + allowlists its git host). AO_DEFAULT_REPO is only the FALLBACK repo for a
# #mgmt request that names no project; empty = the sandbox pool. If set, it's auto-registered as a
# project on boot. So you do NOT hardcode a single project here — you add projects at runtime.
AO_DEFAULT_REPO=
AO_ACTIVITY_BATCH=5

# ── Git identity + deploy tokens (multi-PAT) ─────────────────────────────────
# Agents commit as <role>@<domain> (e.g. worker-default@agent-org.local) so `git blame` and
# hand-off provenance show WHICH agent did what — not the baked "little-coder".
AO_AGENT_EMAIL_DOMAIN=agent-org.local
#
# TOKEN SELECTION (how a repo picks its PAT — resolved automatically at clone time):
#   1. Your OWN repos → the pool's LC_DEPLOY_TOKEN (root .env) — the default, no config.
#   2. An ORG's repos → by convention `LC_<ORG>_TOKEN` (uppercased owner). Any repo under that org
#      auto-uses it — just add the var here. So github.com/PolyshDesign/* → LC_POLYSHDESIGN_TOKEN:
LC_POLYSHDESIGN_TOKEN=
#      To add another org later: LC_<THATORG>_TOKEN=…  (e.g. github.com/Acme/* → LC_ACME_TOKEN).
#   3. A one-off override → `/project add <name> <repo> AO_TOKEN_X` then set AO_TOKEN_X here.
# Secrets via env only; the DB stores just the var NAME. `/project list` shows which token applies.

# The bridge writes the worker git-egress allowlist here (a volume ao-git-egress mounts + reloads).
# The compose default is correct; only change it if you relocate the shared volume mount.
AO_EGRESS_ALLOWLIST_FILE=/egress/egress-allowlist.txt

# ── Proactive alignment controls (UX-FLOW Stage 3/5) — risk-gated by default ─
# Stage-3 plan-approval gate (P3.9) + Stage-5 stop-gates/monitor/review (P4). `risky` = only
# high-blast-radius efforts (keeps routine one-liners fast); `all` = strict spec (every effort gets
# a plan-approval gate + review); `off` = skip. The dry-run gate (P4.0) is always on regardless.
AO_PLAN_APPROVAL=risky
AO_REVIEW_MODE=risky

# ── Ground + dry-run, risk-gated (P4.0) — grounding optional, dry-run gate always on ──
# Grounding submits an effort's assumptions to openbrain-research (best-effort, advisory).
# OFF by default; reach the service BY CONTAINER NAME on llm-net (NOT :8818 host loopback).
AO_GROUNDING_ENABLED=false
AO_RESEARCH_URL=http://openbrain-research:8000
AO_RESEARCH_KEY=
# Stage-1 anchor: one-time read-only worker survey of the repo (languages/structure/conventions)
# feeds the readiness gate so it stops asking placement/language questions. Only fires when a repo
# is focused (AO_DEFAULT_REPO / per-project); the sandbox has nothing to survey.
AO_PROJECT_SURVEY_ENABLED=true

# ── Worker pool egress (reused from little-coder) ───────────────────────────
# OPEN_TERMINAL_API_KEY is read from the MAIN stack .env (../../.env) by the worker services.

# ── Cloud lane (Pc — CONDITIONAL) — leave OFF until P0.5 mandates a cloud judge ──
AO_CLOUD_ENABLED=false
AO_CLOUD_API_KEY=
AO_CLOUD_DB_PASSWORD=change-me-cloud-db
AO_CLOUD_MASTER_KEY=change-me-cloud-master
OPENROUTER_API_KEY=
# Allowlist for ao-egress (OpenRouter host + CDN as needed).
AO_EGRESS_ALLOWLIST=openrouter.ai

# claude-sessions bridge -> agent-memory, through the OPS DOOR (memory-plane §2.4).
# The bridge is a HOST process: openbrain-mcp publishes no host port, and no host process
# should ever hold MCP_ACCESS_KEY. It authenticates with OPS_GATEWAY_KEY (read from
# OB1/docker/.env by the same mechanism as MM_TOKEN) and the door forwards the real key.
# Both default OFF; the per-turn log is much chattier and is opt-in separately.
CLAUDE_MEMORY_ROLLUP_ENABLED=false
CLAUDE_MEMORY_TURNLOG_ENABLED=false
