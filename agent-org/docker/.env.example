# agent-org environment — COPY to agent-org/docker/.env and fill in.
# No secrets in git (README G-convention). Everything below is read by the compose file.

# ── Mattermost ──────────────────────────────────────────────────────────────
MM_DB_PASSWORD=change-me-mattermost-db
MATTERMOST_VERSION=10.5
# Set to the tailnet URL at P7.4 (operator). Loopback default for local bring-up.
MM_SITE_URL=http://localhost:8065

# ── agent-bridge ────────────────────────────────────────────────────────────
AO_DB_PASSWORD=change-me-bridge-db
# Bot access token for @pm/@bridge — created in Mattermost (System Console -> Integrations
# -> Bot Accounts) AFTER first boot (P0.2). Token via env only, never a file.
AO_MATTERMOST_BOT_TOKEN=
# Worker pool (P5). Fill when enabling `--profile workers`; must match the pool instances.
AO_MAX_CONCURRENT_WORKERS=1
AO_WORKER_INSTANCE_URLS=http://ao-worker-1:8090,http://ao-worker-2:8090
# The pool's OWN open-terminal API key (independent of the main stack). Any non-empty value;
# used by both ao-ot-N (API_KEY) and ao-worker-N (the daemon reads OPEN_TERMINAL_API_KEY).
AO_OPEN_TERMINAL_KEY=change-me-ao-ot-key

# ── Open Brain audit mirror (P6.2) — optional ───────────────────────────────
AO_OPENBRAIN_MIRROR_ENABLED=false
AO_OPENBRAIN_URL=http://openbrain-gateway:8061
AO_OPENBRAIN_KEY=

# ── Comms model (channel = project, effort = thread) — defaults are safe ─────
AO_DEFAULT_PROJECT=sandbox
# The org works on ANY repo you onboard from Mattermost with `/project add <name> <repo-url>`
# (creates #proj-<name> + allowlists its git host). AO_DEFAULT_REPO is only the FALLBACK repo for a
# #mgmt request that names no project; empty = the sandbox pool. If set, it's auto-registered as a
# project on boot. So you do NOT hardcode a single project here — you add projects at runtime.
AO_DEFAULT_REPO=
AO_ACTIVITY_BATCH=5
# The bridge writes the worker git-egress allowlist here (a volume ao-git-egress mounts + reloads).
# The compose default is correct; only change it if you relocate the shared volume mount.
AO_EGRESS_ALLOWLIST_FILE=/egress/egress-allowlist.txt

# ── Ground + dry-run, risk-gated (P4.0) — grounding optional, dry-run gate always on ──
# Grounding submits an effort's assumptions to openbrain-research (best-effort, advisory).
# OFF by default; reach the service BY CONTAINER NAME on llm-net (NOT :8818 host loopback).
AO_GROUNDING_ENABLED=false
AO_RESEARCH_URL=http://openbrain-research:8000
AO_RESEARCH_KEY=
# Stage-1 anchor: one-time read-only worker survey of the repo (languages/structure/conventions)
# feeds the readiness gate so it stops asking placement/language questions. Only fires when a repo
# is focused (AO_DEFAULT_REPO / per-project); the sandbox has nothing to survey.
AO_PROJECT_SURVEY_ENABLED=true

# ── Worker pool egress (reused from little-coder) ───────────────────────────
# OPEN_TERMINAL_API_KEY is read from the MAIN stack .env (../../.env) by the worker services.

# ── Cloud lane (Pc — CONDITIONAL) — leave OFF until P0.5 mandates a cloud judge ──
AO_CLOUD_ENABLED=false
AO_CLOUD_API_KEY=
AO_CLOUD_DB_PASSWORD=change-me-cloud-db
AO_CLOUD_MASTER_KEY=change-me-cloud-master
OPENROUTER_API_KEY=
# Allowlist for ao-egress (OpenRouter host + CDN as needed).
AO_EGRESS_ALLOWLIST=openrouter.ai
