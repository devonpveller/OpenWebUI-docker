{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aistack.dev/schemas/request_envelope/v1",
  "title": "AI Stack Request Envelope",
  "description": "Core request envelope for AI Stack module communication",
  "type": "object",
  "required": ["version", "request_id", "timestamp", "user", "input"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Schema version for compatibility",
      "examples": ["v1.0.0"]
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this request"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of request creation"
    },
    "user": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "User identifier"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User roles for authorization"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Specific user permissions"
        }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "description": "Conversation session identifier"
        },
        "turn_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Turn number in conversation"
        }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "default": "en-US",
      "description": "User locale for localization"
    },
    "timezone": {
      "type": "string",
      "description": "User timezone (IANA format)"
    },
    "input": {
      "oneOf": [
        {
          "type": "string",
          "description": "Text input from user"
        },
        {
          "type": "object",
          "description": "Structured input parameters"
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "url", "image"]
          },
          "path": {
            "type": "string",
            "description": "File path or URL"
          },
          "mime_type": {
            "type": "string",
            "description": "MIME type of attachment"
          },
          "size": {
            "type": "integer",
            "description": "Size in bytes"
          }
        }
      },
      "description": "Files or URLs attached to request"
    },
    "context": {
      "type": "object",
      "properties": {
        "prior_turns": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Previous conversation turns"
        },
        "system_hints": {
          "type": "object",
          "description": "System context hints"
        }
      },
      "description": "Contextual information for request"
    },
    "capabilities_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowlist of modules/tools that can be used"
    }
  }
}