FROM ghcr.io/open-webui/open-webui:v0.6.41

# Remove CPU-only PyTorch packages
RUN pip uninstall -y torch torchvision torchaudio

# Install CUDA-enabled PyTorch for CUDA 12.1 (compatible with your CUDA 12.9)
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Verify installation
RUN python -c "import torch; print('PyTorch version:', torch.__version__); print('CUDA available:', torch.cuda.is_available())"