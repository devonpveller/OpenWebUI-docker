---
# Template only — copy to `users_database.yml` and edit. The real file is
# gitignored.
#
# Generate the Argon2id password hash with:
#   docker run --rm authelia/authelia:4.39 \
#     authelia crypto hash generate argon2 --password '<strong-password>'
#
# Requirements (matches password_policy.standard in configuration.yml):
#   - 14+ chars, with upper, lower, number, special
# Verify the password is NOT in haveibeenpwned.com before using:
#   https://haveibeenpwned.com/Passwords
users:
  yourusername:
    disabled: false
    displayname: "Your Name"
    password: "$argon2id$v=19$m=65536,t=3,p=4$..."
    email: yourusername@example.com
    groups:
      - admins
