# ===========================================================================
# portal/.env.example - the PORTAL plane's own environment
# (stack-layers L.2 / D10 / D17, 2026-09-19)
# ===========================================================================
# The internet-exposed auth front-end: caddy, authelia, cloudflared, the
# watchers/alerter/tripwire/cron sidecars and two backups.
# See ../documentation-plans-ai-stack/implementation-guide/open-source authentication front ends for ai stack/
#
# Copy to `portal/.env` and fill in. Compose loads it NATIVELY: passing
# `-f portal/docker-compose.yml` makes `portal/` the PROJECT DIRECTORY, and
# compose reads the `.env` sitting there. No `--env-file` flag, from any
# working directory. `scripts/portal/portal-on.ps1` / `portal-off.ps1` are the
# only supported drivers for this plane - the stack driver treats it as
# `manual` on purpose, because exposing the stack stays a human action.
#
# THE SPLIT RULE (D10): a variable lives in the .env of the plane whose service
# reads it. A value two planes read is DECLARED IN EACH - the plane files are
# independent and compose cannot reference one from another.
#
# NO COMPOSE_PROFILES LINE, deliberately (D17). This plane's one profile,
# `internet`, is passed on the COMMAND LINE by portal-on.ps1 and must NOT be
# standing in a file: a value here would make the tunnel come up on any bare
# `up`, and "the stack is on the internet" is exactly the state that must never
# be reachable by accident.
#
# Nothing in here takes effect until portal-on.ps1 is run.
#
# Migrating an existing deployment: documentation/runbooks/env-split-migration.md.

# --- Public identity ---------------------------------------------------------
PUBLIC_DOMAIN=ai.example.com
ACME_EMAIL=you@example.com

# Cloudflare Tunnel - required (port-forward mode removed from the plan).
# Create the tunnel in the Cloudflare Zero Trust dashboard, paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Authelia secrets --------------------------------------------------------
# Generate each with:
#   docker run --rm authelia/authelia:4.39 authelia crypto rand --length 64
#
# ALL THREE ARE REQUIRED. AUTHELIA_JWT_SECRET carries a PLACEHOLDER rather than
# a blank line for the same reason frontend/.env.example's WEBUI_SECRET_KEY and
# search/.env.example's MULLVAD_WG_PRIVATE_KEY do: it is this plane's `${...:?}`
# fail-loud guard (portal/docker-compose.yml), an EMPTY value trips it, and a
# tripped guard here would break the pre-commit compose check and CI. The other
# two are blank because nothing renders them - which is exactly why blankness
# needs a SECOND mechanism, and it has one: scripts/portal/portal-on.ps1
# pre-flights every key in stack.manifest.toml's [planes.portal] `keys` list
# and refuses to start anything if one is blank.
AUTHELIA_JWT_SECRET=change-me-authelia-crypto-rand-64
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# --- Workbench pass-through --------------------------------------------------
# Server-side secret Caddy injects as X-Brain-Key when proxying /workbench/* to
# openbrain-workbench (G7). Set it to the SAME value as OB1's MCP_ACCESS_KEY
# (OB1/docker/.env) - the two files are independent, so this is a copy you keep
# in step by hand, per D10. Empty = the workbench rejects every /workbench call
# (fail closed).
WORKBENCH_KEY=

# --- Portal-alerter (Gmail self-send via the reused OB1 OAuth client) --------
# DIGEST_TO is where alerts AND scheduled digests land. Use your own Gmail.
# DIGEST_FROM defaults to DIGEST_TO if blank; it should match the Google account
# that consented to the open-brain-email OAuth client.
DIGEST_TO=
DIGEST_FROM=
DIGEST_WINDOW_HOURS=24

# Rate-limit on instant /alert emails (per rolling minute). Excess events in the
# same minute are coalesced into one summary email at minute close.
ALERT_RATE_LIMIT_PER_MIN=20

# Scheduled digest cadence (cron in UTC). Default = daily 07:00 UTC.
PORTAL_DIGEST_CRON=0 7 * * *

# Integrity tripwire schedule (cron in UTC).
TRIPWIRE_CRON=0 4 * * *

# Cloudflare-tunnel liveness probe. Polls the /ready endpoint and alerts after
# FAILURES_BEFORE_ALERT consecutive failures.
TUNNEL_WATCHER_POLL_SEC=30
TUNNEL_WATCHER_FAILURES_BEFORE_ALERT=3

# --- Backup sidecars ---------------------------------------------------------
# *_BACKUP_RETAIN_COUNT is a COUNT of most-recent archives kept, not days.
# These two sidecars are CRON-scheduled (unlike the sleep-loop sidecars on the
# other planes), and each runs a TCP health probe against its source service
# before it touches a file, so a broken service never yields a torn snapshot.
CADDY_BACKUP_RETAIN_COUNT=2
CADDY_BACKUP_CRON=0 3 * * *
CADDY_BACKUP_HEALTH_TCP=caddy:80
AUTHELIA_BACKUP_RETAIN_COUNT=2
AUTHELIA_BACKUP_CRON=0 3 * * *
AUTHELIA_BACKUP_HEALTH_TCP=authelia:9091
