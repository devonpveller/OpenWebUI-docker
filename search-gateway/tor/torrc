# Minimal Tor client config — SOCKS5 anonymizing proxy for SearXNG outbound.
# Bound inside the docker network only; never published to host.
SOCKSPort 0.0.0.0:9050
# 127.0.0.1: the tor-simple image forwards the SOCKS port internally, so
# SearXNG's requests arrive at tor from loopback. Safe to accept — the port
# is never host-published, only reachable inside the docker network.
SOCKSPolicy accept 127.0.0.1
SOCKSPolicy accept 172.16.0.0/12
SOCKSPolicy accept 10.0.0.0/8
SOCKSPolicy accept 192.168.0.0/16
SOCKSPolicy reject *
Log notice stdout
# Client only — never act as a relay or exit.
ExitRelay 0
ClientOnly 1

# Search-reliability tuning (2026-06-14). General engines (brave/ddg/startpage/
# mojeek) 429/403/CAPTCHA our Tor exit IP, then SearXNG benches them 180s. Rotate
# circuits often so fresh streams land on different (hopefully un-flagged) exits
# instead of staying stuck on a burned one.
MaxCircuitDirtiness 45          # new exit for fresh streams every 45s (def 600)
# NOTE: deliberately NOT setting a fixed CircuitBuildTimeout — Tor's adaptive
# timeout keeps the widest pool of usable exits, which we want for diversity.
