# portal/config/alerter/.env.example
#
# These vars are read by `portal-alerter` (alerter.ts). The canonical place
# to set them is the PORTAL plane's `portal/.env` (see portal/.env.example,
# which documents every one) - docker compose reads that file for this plane.
# This file documents the shape — do not commit a real .env here.

# Channels: every alert goes to every channel set; success = any delivered.
# Telegram (primary; the sysadmin bot) - names only, values in portal/.env:
PORTAL_ALERT_TELEGRAM_BOT_TOKEN=
PORTAL_ALERT_TELEGRAM_CHAT_ID=
# Mattermost (primary; bot post into one channel):
PORTAL_ALERT_MM_URL=http://host.docker.internal:8065
PORTAL_ALERT_MM_TOKEN=
PORTAL_ALERT_MM_CHANNEL_ID=
PORTAL_ALERT_MM_MENTION=
PORTAL_ALERT_HOST_LABEL=portal

# Email copy of every alert AND the scheduled digests (digest = email only).
# Must be a Gmail address. Blank = email off.
DIGEST_TO=you@example.com

# From address. Must match the Google account that consented to the
# open-brain-email OAuth client. If left blank, defaults to DIGEST_TO.
DIGEST_FROM=

# Window the scheduled /run digest covers, in hours.
# Default 24 (daily digest at 07:00 UTC).
DIGEST_WINDOW_HOURS=24

# Rate limit on instant /alert sends (all channels), per rolling minute.
# Excess events in the same minute are queued and coalesced into a
# single summary email at minute close. Prevents a log-flood attack
# from generating a Gmail quota burst.
ALERT_RATE_LIMIT_PER_MIN=20

# Scheduled digest cadence (cron in UTC). Drives the line in
# portal/config/portal-cron/crontab.
PORTAL_DIGEST_CRON=0 7 * * *

# Echoed in email footers for context (does not affect routing).
PUBLIC_DOMAIN=ai.example.com
