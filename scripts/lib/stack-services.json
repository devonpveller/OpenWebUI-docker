{
  "_comment": [
    "Canonical service inventory for the ai-stack health checkers — the single",
    "source of truth for WHAT to check, to stop the three checkers from drifting.",
    "Consumed directly by status_check.py (data-driven liveness loop). The",
    "PowerShell monitor (check-tailscale-health.ps1) and quick-fixes.bat keep their",
    "bespoke probe/recovery logic but should be reconciled against this list when",
    "containers are added/removed (alongside compose + recovery scripts + stack-map,",
    "per CLAUDE.md's three-place convention).",
    "",
    "IMPORTANT: 'container' is the docker container NAME (use with `docker inspect`).",
    "For the ai-stack project some compose SERVICE keys differ from container names",
    "(service tor->search-tor, redis->search-redis, gateway->search-gateway,",
    "mcpo->search-mcpo) — see the 'service' field where it differs.",
    "Open Brain is a SEPARATE compose project (open-brain); a plain `docker compose`",
    "from the ai-stack dir cannot see it — probe its containers by name."
  ],
  "projects": {
    "ai-stack":   { "compose": "docker compose" },
    "open-brain": { "compose": "docker compose -f OB1/docker/docker-compose.yml" }
  },
  "planes": {
    "core": [
      { "container": "openwebui",       "project": "ai-stack", "critical": true,  "host_health": "http://127.0.0.1:3000/health" },
      { "container": "tailscale",       "project": "ai-stack", "critical": true },
      { "container": "llama-cpp",       "project": "ai-stack", "critical": true,  "host_health": "http://127.0.0.1:8081/health" },
      { "container": "llama-cpp-embed", "project": "ai-stack", "critical": false, "host_health": "http://127.0.0.1:8082/health" },
      { "container": "watchtower",      "project": "ai-stack", "critical": false }
    ],
    "memory": [
      { "container": "mnemory",         "project": "ai-stack", "critical": false },
      { "container": "mnemory-gateway", "project": "ai-stack", "critical": false }
    ],
    "search": [
      { "container": "search-tor",     "project": "ai-stack", "service": "tor",     "critical": false },
      { "container": "search-redis",   "project": "ai-stack", "service": "redis",   "critical": false },
      { "container": "searxng",        "project": "ai-stack", "service": "searxng", "critical": false },
      { "container": "search-gateway", "project": "ai-stack", "service": "gateway", "critical": false, "host_health": "http://127.0.0.1:8085/healthz" },
      { "container": "search-mcpo",    "project": "ai-stack", "service": "mcpo",    "critical": false }
    ],
    "coder": [
      { "container": "open-terminal", "project": "ai-stack", "critical": false },
      { "container": "little-coder",  "project": "ai-stack", "critical": false },
      { "container": "lc-mcpo",       "project": "ai-stack", "critical": false },
      { "container": "lc-egress",     "project": "ai-stack", "critical": false }
    ],
    "notebook": [
      { "container": "open_notebook", "project": "ai-stack", "critical": false, "note": "being retired (Quartz workbench); still live for podcasts" },
      { "container": "surrealdb",     "project": "ai-stack", "critical": false, "note": "open-notebook DB; WS-only, no HTTP health" }
    ],
    "ingest": [
      { "container": "smolcrawl-pipelines", "project": "ai-stack", "critical": false, "host_health": "http://127.0.0.1:9099/" }
    ],
    "openbrain": [
      { "container": "openbrain-db",          "project": "open-brain", "critical": true,  "note": "stale-pool dependency: if this restarts after openbrain-mcp, mcp must be restarted" },
      { "container": "openbrain-mcp",         "project": "open-brain", "critical": true,  "stale_pool_guard": "openbrain-db", "note": "holds a long-lived DB connection that does NOT auto-reconnect; OWUI tool 500s / 'Broken pipe' when stale" },
      { "container": "openbrain-mcpo",        "project": "open-brain", "critical": true,  "note": "MCP->OpenAPI bridge Open WebUI tools call" },
      { "container": "openbrain-mcpo-ext",    "project": "open-brain", "critical": false },
      { "container": "openbrain-gateway",     "project": "open-brain", "critical": false, "host_health": "http://127.0.0.1:8061/health" },
      { "container": "openbrain-rest",        "project": "open-brain", "critical": false, "host_health": "http://127.0.0.1:3001/" },
      { "container": "openbrain-postgrest",   "project": "open-brain", "critical": false },
      { "container": "openbrain-wiki",        "project": "open-brain", "critical": false },
      { "container": "openbrain-wiki-viewer", "project": "open-brain", "critical": false },
      { "container": "openbrain-entity-worker","project": "open-brain","critical": false }
    ]
  }
}
