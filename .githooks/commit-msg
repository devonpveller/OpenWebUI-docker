#!/bin/sh
# commit-msg - a gitlink bump may not name a commit that does not exist.
#
# WHY THIS EXISTS. A gitlink bump commit was written with the message "OB1 -> 5a54f18,
# pushed before this bump". The gitlink was correct and the commit WAS pushed - but
# 5a54f18 is not a commit in OB1. It is not a commit anywhere. It was typed from memory
# instead of read, and nothing between typing it and pushing it looked.
#
# That matters more than a cosmetic slip, because this repository's rule for the submodule
# is "never bump the gitlink to a commit that isn't on the OB1 remote", and the commit
# message is where a reader checks that. A message naming a SHA that does not exist is
# indistinguishable, to anyone reading history later, from a bump to an unreachable commit
# - and it makes the honest ones less believable too.
#
# CLAUDE.md already says to verify. This makes the claim mechanically checkable instead,
# which is the same move the repo made for --no-verify: a rule that has to be remembered is
# not containment.
#
# WHAT IT CHECKS: when a submodule gitlink is staged, every SHA-shaped token in the message
# must resolve to a real object in that submodule. Tokens are 7-40 hex characters CONTAINING
# AT LEAST ONE DIGIT - without the digit rule, ordinary words that happen to be hex
# ("defaced", "facade", "decade", "added") would be treated as commit claims and this hook
# would fail honest messages, which is how a guard gets deleted.
#
# Activate in a fresh clone with:  git config core.hooksPath .githooks

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

# --- CANONICALISE THE MESSAGE, BEFORE ANYTHING JUDGES IT OR RECORDS IT ------
#
# This is the chokepoint. The attester used to digest a REDUCTION of the message and the
# guard reduced the stored message the same way - and any text that reduction discarded
# but git STORED was an unguarded rewrite channel. `git commit --amend --no-verify -m
# '# <lie>' + <attested subject>` landed a lie in the commit subject with no guard line,
# because `-m` selects cleanup=whitespace and git stores '#' lines verbatim.
#
# Rewriting the file instead of reducing the digest removes the channel rather than the
# spelling: from here on, the bytes that are attested ARE the bytes git stores, so there is
# nothing left for a future spelling to hide in. Full reproduction and the fixed-point
# invariant this rests on: .githooks/attest-lib.sh.
#
# IT HAPPENS BEFORE THE VETO ON PURPOSE. The gitlink check must judge the message that will
# be STORED, not a draft that still has text below a scissors line.
_lib="$(dirname "$0")/attest-lib.sh"
if [ -r "$_lib" ]; then
    . "$_lib"
    _attest_canonicalise_file "$MSG_FILE"
fi

# THE CHECK IS A FUNCTION SO THAT THE ATTESTATION BELOW ALWAYS RUNS.
#
# It used to be straight-line code that `exit 0`d as soon as it saw no staged gitlink -
# which is nearly every commit. Splicing the attester in underneath it would have attested
# only gitlink bumps, and .githooks/reference-transaction would then have refused every
# ordinary commit in the repo. That defect existed for the length of one drill run and was
# caught by MUTATING the hook rather than by reading it: the drill's fixture had been
# REASSEMBLING commit-msg from a marker-extracted block, so it could not see this file's
# real control flow at all. The fixture now copies this file verbatim and drives it with a
# real submodule, and it is that change - not this comment - that keeps the two honest.
_check_gitlink_shas() {
    # Which submodules are staged in THIS commit? Mode 160000 is a gitlink.
    SUBS=$(git diff --cached --raw | awk '$2 == "160000" || $1 == ":160000" { print $NF }' | sort -u)
    [ -z "$SUBS" ] && return 0

    # Strip comment lines. Redundant now that the message is canonicalised above - and kept
    # anyway, because it is the ONLY thing standing here if attest-lib.sh is ever missing,
    # and `git commit -v` puts an entire diff below those lines, full of real-looking hex
    # that has nothing to do with the message.
    BODY=$(grep -v '^#' "$MSG_FILE")

    CLAIMS=$(printf '%s' "$BODY" | grep -oE '\b[0-9a-f]{7,40}\b' | grep -E '[0-9]' | sort -u)
    [ -z "$CLAIMS" ] && return 0

    BAD=""
    for sha in $CLAIMS; do
        found=""
        for sub in $SUBS; do
            [ -d "$sub" ] || continue
            # GIT_DIR MUST BE UNSET FOR THE SUBMODULE LOOKUP.
            #
            # git runs hooks with GIT_DIR (and GIT_INDEX_FILE) pointing at the PARENT repo, and
            # those win over `-C`: `git -C OB1 cat-file` would happily change directory and then
            # resolve the SHA against the parent's object store, where a submodule commit does
            # not exist. Every honest bump would be rejected.
            #
            # This is not hypothetical - it is what happened the first time this hook ran for
            # real, on a message naming the correct SHA. The drill missed it because the drill
            # invokes this script directly, where GIT_DIR is unset; git's invocation and a
            # direct invocation are different environments, and only one of them is the one
            # that matters. The drill now sets GIT_DIR to match.
            if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; git -C "$sub" cat-file -e "${sha}^{commit}") 2>/dev/null; then
                found="yes"
                break
            fi
        done
        # A SHA that resolves in the PARENT repo is fine too - messages legitimately cite
        # parent commits alongside a submodule bump.
        if [ -z "$found" ] && git cat-file -e "${sha}^{commit}" 2>/dev/null; then
            found="yes"
        fi
        [ -z "$found" ] && BAD="$BAD $sha"
    done

    if [ -n "$BAD" ]; then
        echo "commit-msg: this message names commit(s) that do not exist:" >&2
        for sha in $BAD; do echo "    $sha" >&2; done
        echo "" >&2
        echo "  Staged submodule(s):$(printf ' %s' $SUBS)" >&2
        for sub in $SUBS; do
            actual=$(git ls-files -s "$sub" 2>/dev/null | awk '{print $2}')
            [ -n "$actual" ] && echo "    $sub is pinned at $actual" >&2
        done
        echo "" >&2
        echo "  A gitlink bump is checked by reading the SHA in its message. One that does not" >&2
        echo "  exist is indistinguishable from a bump to an unreachable commit, and it makes" >&2
        echo "  the honest ones less believable. Read the SHA rather than recalling it:" >&2
        echo "" >&2
        echo "    git -C <submodule> rev-parse HEAD" >&2
        return 1
    fi
    return 0

}

# Refusal is the ONLY early exit, and it happens before anything is recorded.
_check_gitlink_shas || exit 1

# --- ATTESTATION -----------------------------------------------------------
# THE LAST THING THE LAST VETO HOOK DOES. Everything above this line can still refuse the
# commit; nothing below it can. That ordering is the whole mechanism - see
# .githooks/attest-lib.sh for the bypass it closes and how it was measured.
#
# WE RECORD (TREE, MESSAGE):
#   - the TREE, because it is the durable identity of the content, and `git write-tree`
#     here yields exactly the tree the resulting commit will carry - including a PARTIAL
#     commit, where git hands its hooks a temporary index, and a CLEAN MERGE, where the
#     index already holds the merge result and git invokes this hook with .git/MERGE_MSG.
#   - the MESSAGE, because the tree alone let `--amend --no-verify` rewrite a message
#     against an already-attested tree. The message is what a reviewer reads to check a
#     gitlink bump, and PLAN.md section C.7 makes it the operator's audit surface.
#     The digest is of the CANONICALISED FILE - i.e. of the exact bytes git will store -
#     so the verifier can hash the stored message with no transformation at all. A digest
#     over a reduction is a digest with a hole in it; that is round 3's whole finding.
#
# The ledger lives in the SHARED git dir (--git-common-dir), never a worktree: it must not
# be committable, and every worktree of this repo must read ONE ledger, or a reviewer in
# another worktree could not verify a developer's work.
#
# FAILS QUIET HERE, CLOSED THERE. If any part of this cannot be computed we simply do not
# write a line; the commit is then refused by .githooks/reference-transaction, which is the
# safe direction. Never exit non-zero from this block - a bookkeeping failure must not be
# reported to the user as a rejected message.
if [ -r "$_lib" ]; then
    _at_tree=$(git write-tree 2>/dev/null)
    _at_msg=$(_attest_digest_file "$MSG_FILE")
    _at_common=$(git rev-parse --git-common-dir 2>/dev/null)
    if [ -n "$_at_tree" ] && [ -n "$_at_msg" ] && [ -n "$_at_common" ]; then
        # NOT $(git rev-parse --abbrev-ref HEAD || echo '?'): on an unborn HEAD git prints
        # "HEAD" to stdout AND exits non-zero, so BOTH sides of the || run and the ledger
        # got a malformed two-line record. Assign first, then substitute.
        _at_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || _at_branch='?'
        [ -n "$_at_branch" ] || _at_branch='?'
        printf '%s %s %s %s\n' "$_at_tree" "$_at_msg" \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_at_branch" \
            >> "$_at_common/hook-attest.log" 2>/dev/null || true
    fi
fi
exit 0
