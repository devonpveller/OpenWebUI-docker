#!/bin/sh
# reference-transaction - the COMMIT-PATH PROXY (dark-factory-unification U5).
#
# WHY THIS EXISTS. U5 asks for "mechanical guards for worktree/cloud agents (hook-bypass
# detection at minimum; commit-path proxy where feasible)". Detection already existed:
# .githooks/pre-commit step 6 writes a tree attestation and
# scripts/checks/check-hook-attestation.ps1 reads it back. But detection is AFTER THE
# FACT - it runs when a reviewer looks. A bypassing agent's commit still lands on its
# branch, and whether anyone ever looks is a human question, which is exactly the class
# of assurance PLAN 0 A7 recorded as FALSIFIED.
#
# agent-org solved the equivalent problem with a PROXY: inside the worker container `git`
# on $PATH IS little-coder/git-proxy/git_proxy.py, so a push to main is not reported, it
# is refused (little-coder/git-proxy/git_proxy.py:154 _PROTECTED_BRANCHES). A worktree
# agent on this host has no such chokepoint - it runs as the operator's own user with the
# real git.exe on PATH, and any PATH shim it can be given it can also step around.
#
# THE ONE CHOKEPOINT THAT IS LEFT is inside git itself, and it is this hook. Measured, not
# assumed (2026-08-30):
#
#   git commit --no-verify   -> pre-commit SKIPPED, commit-msg SKIPPED,
#                               reference-transaction STILL RUNS.
#   exit non-zero at state=prepared
#                            -> "fatal: ref updates aborted by hook", exit 128,
#                               the branch does NOT move, the new commit is left dangling.
#
# So `--no-verify` - the documented, reached-for, trace-free bypass that motivated the
# attestation ledger - cannot advance a branch any more. It is stopped, not noticed.
#
# THE RULE. At `prepared`, for every refs/heads/* update, the commit the branch is about
# to point at must have a tree in the attestation ledger. Anything else aborts the whole
# transaction and writes an audit record.
#
# WHAT IS DELIBERATELY NOT CHECKED, because a guard that fires on honest work gets
# switched off and then protects nothing (the lesson check-hook-attestation.ps1 paid for):
#
#   - refs that are not refs/heads/* (refs/remotes, refs/tags, refs/stash, HEAD,
#     AUTO_MERGE, ORIG_HEAD). Nothing there is a commit path.
#   - ref DELETION (new value all-zero).
#   - a commit that is ALREADY REACHABLE from some existing ref. That is a ref MOVE, not
#     new content: `git branch`/`git switch -c`/`git worktree add -b` at an existing
#     commit, `git reset` in either direction, a multi-commit fast-forward, a pull whose
#     objects arrived under refs/remotes first. Measured shapes are in
#     scripts/agent-harness/verify-commit-path-guard.ps1 (the "ref move" cases). This is
#     reachability, computed from the repo - not a date, not an environment variable.
#   - anything committed while the SEQUENCER is running (rebase, cherry-pick, revert).
#     git does not run pre-commit for replayed commits, so their trees cannot be
#     attested and demanding it would block every reviewer rebase in MERGE-PROTOCOL.md.
#     These are LOGGED as SKIP-SEQUENCER rather than passed silently, and
#     check-hook-attestation.ps1 still reports them afterwards - the after-the-fact net
#     is not removed, it is what remains for this case.
#
# WHAT IT CANNOT STOP, stated plainly because a guard oversold is a guard mistrusted.
# The agent runs as the operator's own user with the real git.exe, so there is no
# privilege boundary to hide a policy behind. Two routes remain, both MEASURED
# (2026-08-30), not reasoned about:
#
#   git -c core.hooksPath=/nonexistent commit -m ...        -> lands. Turns off every
#       hook including this one. This is also the operator's deliberate escape hatch;
#       the commit is reported UNATTESTED by check-hook-attestation.ps1 afterwards.
#   git update-ref refs/pre/x <sha> && git update-ref refs/heads/b <sha>   -> lands.
#       Parking the commit under a ref OUTSIDE refs/heads/* makes it "already reachable",
#       and the second update is then treated as a ref move. Narrowing the reachability
#       exemption would only push this to `git tag`, and it would start refusing an
#       honest `git checkout -b rel <tag>` - so the exemption is deliberately kept wide.
#       Note the direct route is closed: `git update-ref refs/heads/b <unattested>` is
#       itself refused, because refs/heads is what this hook watches.
#
# WHAT IS *NOT* A ROUTE, contrary to the obvious guess: deleting the ledger. The guard
# fails CLOSED - a missing ledger denies everything with reason=no-ledger. It is
# check-hook-attestation.ps1 that a deleted ledger neutralises (it reports INACTIVE), so
# the two mechanisms fail in opposite directions and that is worth keeping.
#
# What changed is cost and trace: `--no-verify` was one word that left no evidence at
# all; each surviving route is a deliberate, unusual, separately-visible command. See
# documentation/notes/u5proxy-findings.md for the full boundary.
#
# Activate in a fresh clone with:  git config core.hooksPath .githooks
# Turn off deliberately (operator):  git -c core.hooksPath=/nonexistent <cmd>

[ "$1" = "prepared" ] || exit 0

common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
[ -n "$common" ] || exit 0
gitdir=$(git rev-parse --git-dir 2>/dev/null)
[ -n "$gitdir" ] || gitdir="$common"
ledger="$common/hook-attest.log"
guardlog="$common/hook-guard.log"
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# The sequencer's state lives in the PER-WORKTREE git dir, not the shared one.
seq=""
for m in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$gitdir/$m" ] && seq="$m"
done

denied=""
while read -r old new ref; do
    case "$ref" in refs/heads/*) ;; *) continue ;; esac
    # all-zero new value = deletion
    case "$new" in *[!0]*) ;; *) continue ;; esac
    git rev-parse -q --verify "$new^{commit}" >/dev/null 2>&1 || continue

    if [ -n "$seq" ]; then
        printf '%s SKIP-SEQUENCER ref=%s commit=%s state=%s\n' "$now" "$ref" "$new" "$seq" \
            >> "$guardlog" 2>/dev/null || true
        continue
    fi

    # Already-known history => this is a ref MOVE, not new content.
    if [ -n "$(git for-each-ref --contains="$new" --count=1 --format='%(refname)' 2>/dev/null)" ]; then
        continue
    fi

    tree=$(git rev-parse -q --verify "$new^{tree}" 2>/dev/null)
    [ -n "$tree" ] || continue
    if [ -f "$ledger" ] && grep -q "^$tree " "$ledger" 2>/dev/null; then
        continue
    fi

    reason="unattested-tree"
    [ -f "$ledger" ] || reason="no-ledger"
    printf '%s DENY ref=%s commit=%s tree=%s reason=%s wt=%s\n' \
        "$now" "$ref" "$new" "$tree" "$reason" "$(git rev-parse --show-toplevel 2>/dev/null)" \
        >> "$guardlog" 2>/dev/null || true
    denied="$denied $ref"
done

[ -z "$denied" ] && exit 0

echo "" >&2
echo "COMMIT-PATH GUARD: refusing to advance$denied" >&2
echo "" >&2
echo "  The commit this branch would point at has a tree the pre-commit checks never" >&2
echo "  validated. The usual cause is 'git commit --no-verify' or 'git merge --no-verify'." >&2
echo "  Nothing was lost: the commit object exists, the branch simply did not move." >&2
echo "" >&2
echo "  Re-run the commit WITHOUT --no-verify. The checks it skips are the secret guard," >&2
echo "  the line-ending rule, the LLM-gateway routing rule, the compose/ps1 structural" >&2
echo "  check and the env_file scope rule - each of which exists because it caught a real" >&2
echo "  failure. If a check is genuinely wrong, fix the check." >&2
echo "" >&2
echo "  Audit record: $guardlog" >&2
echo "" >&2
exit 1
