#!/bin/sh
# Pre-commit hook - VERSION CONTROLLED (see .githooks/README.md)
#
# Activate in a fresh clone with:
#   git config core.hooksPath .githooks
#
# Checks, in order of how cheap they are:
#   0b. hook modes       - the hooks themselves must be 100755
#   0c. exec bits        - a file the stack runs by path must be 100755
#   1. secret guard      - staged-only scan; blocks env files + provider tokens
#   2. line endings      - repo convention
#   2b. doc placement    - new plans belong in the documentation-plans repo
#   3. gateway routing   - inference must go through the LiteLLM alias
#   3b. corpus exposure  - a direct corpus INSERT must state its plane
#   4. project configs   - compose renders + ps1 tokenize
#   4b. doc blocks       - the docs' generated counts still match the renders
#   5. env_file scope    - a service names the variables it needs
#   5b. OB1 recipe tests - a staged OB1 gitlink bump must pass its unit tests
#   5c. OB1 deno recipes - and must type-check the Deno recipe 5b cannot see
#   5d. OB1 int. images  - and its integration images must build and resolve

echo "Running pre-commit validations..."

# --- 0. which host runs the gates (ac-hooks-portable, 2026-09-25) ----------
# Every gate below is a .ps1, and until this block the hook called
# `powershell.exe` by name. On Linux or macOS that is "not found" (exit 127), and
# the first gate then reported "secret detected in staged files" - a blanket
# failure with a false reason. (That was only reachable once the hook was made
# executable: at 3c3ff75 every hook was committed 100644, so a real Linux clone
# skipped them all with a `hint:` and committed anything - see step 0b.)
#
# THE ORDER, and the first match wins:
#   1. powershell.exe - Windows, and ONLY in a native Windows git shell: `uname -s`
#      is MINGW*/MSYS*/CYGWIN* (Git for Windows' bash says MINGW64_NT-...). Every
#      gate then runs exactly as it always has: the command line is the one this
#      hook has always used, and nothing else (not even a Python probe) happens on
#      this path - except step 0c's drift half, which has no PowerShell twin and
#      looks for Python on every host (see 0c). WHY THE uname TEST (ac-hooks-portable2, review blocker 1): WSL puts
#      Windows' powershell.exe on PATH through interop. Picking it there ran the
#      gates in Windows PowerShell with WINDOWS git against a \\wsl.localhost path;
#      that git refused the repo ("dubious ownership"), the secret guard read the
#      refusal as "nothing staged - skip", and the summary listed it RAN (measured
#      by the reviewer on this host's Ubuntu). On WSL, or any Linux with a
#      powershell.exe on PATH, the hook now falls through to pwsh, then Python.
#   2. pwsh           - PowerShell 7, any OS. The same .ps1 gates, the same flags.
#   3. python3        - only the gates that have a Python twin under
#      scripts/checks/ run: the secret guard, line endings and gateway routing.
#      Each twin mirrors its .ps1 rule for rule; its header says what it copies.
#      Every other gate prints `SKIPPED <gate>: ...` and does not fail the commit.
#
# THE THREE THAT ARE NEVER SKIPPED. The secret guard, line endings and gateway
# routing have a twin precisely so that no host can leave them out. If neither a
# PowerShell host nor Python 3 is present, run_gate REFUSES the commit on them
# instead of skipping - a secret guard that can be skipped is not a guard.
#
# A skip is never silent: it prints a line as it happens, the summary at the
# end names every gate RAN and SKIPPED, and the attestation (step 6) records the
# skipped ones in a fifth column, so the ledger cannot claim a check that did
# not run. On Windows nothing is skipped and the ledger line is unchanged.
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) _native_windows=yes ;;
    *) _native_windows= ;;
esac
if [ -n "$_native_windows" ] && command -v powershell.exe >/dev/null 2>&1; then
    PS_HOST=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    PS_HOST=pwsh
else
    PS_HOST=
fi
PY_HOST=
if [ -z "$PS_HOST" ]; then
    for _cand in python3 python; do
        if command -v "$_cand" >/dev/null 2>&1 &&
           "$_cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
            PY_HOST=$_cand
            break
        fi
    done
fi
GATES_RAN=
GATES_SKIPPED=

print_summary() {
    echo "Pre-commit gates (host: ${PS_HOST:-${PY_HOST:-none}}) - RAN:${GATES_RAN:- (none)} | SKIPPED:${GATES_SKIPPED:- (none)}"
}

# run_gate <gate> <ps1> <python twin, or ''> <never-skip: yes|no> <failure line>
run_gate() {
    _gate=$1; _ps1=$2; _py=$3; _never_skip=$4; _fail=$5
    if [ -n "$PS_HOST" ]; then
        "$PS_HOST" -NoProfile -ExecutionPolicy Bypass -File "$_ps1"
        _rc=$?
    elif [ -n "$_py" ] && [ -n "$PY_HOST" ]; then
        "$PY_HOST" "$_py"
        _rc=$?
    elif [ "$_never_skip" = yes ]; then
        echo "REFUSED $_gate: this gate is never skipped, and neither PowerShell (powershell.exe, pwsh) nor Python 3 is on PATH to run it."
        echo "  Install python3 (runs $_py) or pwsh (runs $_ps1), then commit again."
        print_summary
        exit 1
    else
        echo "SKIPPED $_gate: needs PowerShell (install pwsh to run it)"
        GATES_SKIPPED="$GATES_SKIPPED $_gate"
        return 0
    fi
    if [ $_rc -ne 0 ]; then
        echo "$_fail"
        print_summary
        exit 1
    fi
    GATES_RAN="$GATES_RAN $_gate"
}

# --- 0b. hook modes (inline, needs no host) ---------------------------------
# git RUNS A HOOK ONLY IF IT IS EXECUTABLE. A hook committed as mode 100644 is
# checked out 0644 by every Linux/macOS clone, and git then skips it with a
# one-line `hint:` - no gate runs, a staged secret commits with exit 0, and no
# attestation is written. Until 2026-09-25 all three hooks here were 100644, and
# nobody on this Windows host could see it: core.fileMode=false, and Git for
# Windows runs a hook whatever its mode. (Found by ac-hooks-portable's tester in
# a genuine Linux clone; every earlier container run had copied a Docker Desktop
# bind mount, where every file reads -rwxrwxrwx.)
#
# A hook cannot report its OWN missing x bit - by then it is not running. What
# it can do is refuse to commit a tree in which any hook has lost it, which is
# how a Windows commit (the one place this hook always runs) would reintroduce
# the problem. Silent when every hook is 100755.
#
# ONLY A FILE NAMED AS A GIT HOOK is checked (ac-hooks-portable2, review carry):
# a README, a NOTES.MD or a sourced helper such as lib.sh is never executed by
# git and needs no x bit. A SYMLINK (120000) is skipped too: git runs its
# target, whose mode this index entry does not hold. And the index query FAILS
# CLOSED: if git cannot answer, this step refuses rather than finding nothing.
_hook_names=' applypatch-msg pre-applypatch post-applypatch pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit pre-rebase post-checkout post-merge pre-push pre-receive update proc-receive post-receive post-update reference-transaction push-to-checkout pre-auto-gc post-rewrite sendemail-validate fsmonitor-watchman p4-changelist p4-prepare-changelist p4-post-changelist p4-pre-submit post-index-change '
if ! _hook_index=$(git ls-files -s -- .githooks); then
    echo "hook-modes: git ls-files failed - cannot tell whether the hooks are executable."
    echo "Pre-commit validation failed (a hook is not executable in the index)!"
    print_summary
    exit 1
fi
_bad_modes=$(printf '%s\n' "$_hook_index" | awk -v names="$_hook_names" '
    NF == 0 { next }
    { mode = $1; path = $0; sub(/^[^\t]*\t/, "", path); leaf = path; sub(/^.*\//, "", leaf) }
    mode != "100755" && mode != "120000" && index(names, " " leaf " ") { print path }')
if [ -n "$_bad_modes" ]; then
    echo "Hook file(s) staged without the executable bit - git would SKIP them on Linux/macOS:"
    printf '    %s\n' $_bad_modes
    echo "  Fix: git update-index --chmod=+x <file>   (works on Windows too, where chmod does not)"
    echo "Pre-commit validation failed (a hook is not executable in the index)!"
    print_summary
    exit 1
fi
GATES_RAN="$GATES_RAN hook-modes"

# --- 0c. exec bits (inline sh + Python, ac-exec-bits, 2026-09-25) ------------
# A file the stack RUNS BY PATH - a sidecar's `/scripts/backup.sh`, an image's CMD
# on a bind-mounted script, a documented `scripts/x.sh` - runs on Linux/macOS only
# if git recorded it 100755; otherwise the container says "Permission denied" (and
# a backup sleep-loop swallows that and stays "running"). This host cannot see the
# difference (core.fileMode=false; Docker Desktop shows every bind mount
# -rwxrwxrwx), so the rule is checked against the INDEX, here.
#
# TWO HALVES, and they fail differently on purpose:
#   exec-bits-modes  plain sh, needs no host, NEVER skipped: every path listed in
#                    scripts/checks/exec-bits.inventory must be 100755 in the index.
#                    FAILS CLOSED: if git cannot answer, or the inventory is missing
#                    from the index, the commit is refused, not waved through.
#   exec-bits-drift  scripts/checks/check_exec_bits.py --check re-derives the set from
#                    the staged compose files, Dockerfiles, crontabs, docs and CI, and
#                    refuses a commit whose inventory no longer matches (a NEW
#                    directly-executed script) or whose derived files lack the bit.
#                    It has no PowerShell twin, so it needs Python 3.8+ on EVERY host,
#                    Windows included, and is found independently of PS_HOST/PY_HOST
#                    (step 0 probes Python only when there is no PowerShell). With no
#                    Python it is SKIPPED, loudly, and lands in the summary and the
#                    ledger's skipped= column like any other skipped gate.
_xb_inv=scripts/checks/exec-bits.inventory
if ! git cat-file -e ":$_xb_inv" 2>/dev/null; then
    echo "exec-bits: $_xb_inv is not in the index - the list of directly-executed files is gone."
    echo "  Fix: python3 scripts/checks/check_exec_bits.py --write, then git add it."
    echo "Pre-commit validation failed (a directly-executed file lost its executable bit)!"
    print_summary
    exit 1
fi
if ! _xb_list=$(git show ":$_xb_inv") || ! _xb_index=$(git -c core.quotePath=false ls-files -s); then
    echo "exec-bits: git could not read the inventory or the index - cannot tell which files are executable."
    echo "Pre-commit validation failed (a directly-executed file lost its executable bit)!"
    print_summary
    exit 1
fi
_xb_bad=$( { printf '%s\n' "$_xb_list" | awk -F'\t' '!/^#/ && NF { print "L\t" $1 }'
             printf '%s\n' "$_xb_index" | awk '{ m = $1; p = $0; sub(/^[^\t]*\t/, "", p); print "I\t" p "\t" m }'; } |
    awk -F'\t' '$1 == "I" { mode[$2] = $3; next } $1 == "L" { want[++n] = $2 }
                END { for (i = 1; i <= n; i++) if (mode[want[i]] != "100755") print (mode[want[i]] == "" ? "untracked" : mode[want[i]]) " " want[i] }')
if [ -n "$_xb_bad" ]; then
    echo "Executed directly but not 100755 in the index - Linux/macOS would say 'Permission denied':"
    printf '%s\n' "$_xb_bad" | sed 's/^/    /'
    echo "  Fix: git update-index --chmod=+x <file>   (works on Windows too, where chmod does not)"
    echo "Pre-commit validation failed (a directly-executed file lost its executable bit)!"
    print_summary
    exit 1
fi
GATES_RAN="$GATES_RAN exec-bits-modes"
_xb_py=$PY_HOST
if [ -z "$_xb_py" ]; then
    for _cand in python3 python; do
        if command -v "$_cand" >/dev/null 2>&1 &&
           "$_cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
            _xb_py=$_cand
            break
        fi
    done
fi
if [ -n "$_xb_py" ]; then
    "$_xb_py" scripts/checks/check_exec_bits.py --check
    if [ $? -ne 0 ]; then
        echo "Pre-commit validation failed (exec bits: inventory drift or a missing executable bit)!"
        print_summary
        exit 1
    fi
    GATES_RAN="$GATES_RAN exec-bits-drift"
else
    echo "SKIPPED exec-bits-drift: needs Python 3.8+ (a NEW directly-executed script would not be caught; the listed ones were checked above)"
    GATES_SKIPPED="$GATES_SKIPPED exec-bits-drift"
fi

# --- 1. secrets (staged content only, so it stays fast) --------------------
# Added 2026-08-20 after two .env.bak-* files reached a commit and were only
# stopped at push time by GitHub push protection - which matched 2 GitHub PATs
# while each file held ~25 live credentials. Catch it at commit time instead.
run_gate secrets './scripts/checks/check-staged-secrets.ps1' \
    './scripts/checks/check_staged_secrets.py' yes \
    "Pre-commit validation failed (secret detected in staged files)!"

# --- 2. line endings -------------------------------------------------------
run_gate line-endings './scripts/checks/validate-lineendings.ps1' \
    './scripts/checks/validate_lineendings.py' yes \
    "Pre-commit validation failed (line endings)!"

# --- 2b. documentation placement (staged-aware) ----------------------------
# Fail if this commit ADDS planning material to the code repo. Plans, build logs,
# task lists and numbered plan sets belong in the private plan store,
# documentation-plans-ai-stack; this repo carries the one-row status entry in
# documentation/implementation-guide/README.md and nothing else of a plan.
# Since 2026-09-25 the same goes for the operator journal: a new file under
# documentation/notes|evidence|archive/, or a new root-level TEST-PLAN*/
# *-FINDINGS*/PLAN* file, is refused with the store path to write it at.
#
# It is a PARTIAL guard and the script header says so plainly: the drift it is
# named after (a 24-file plan set written into documentation/implementation-guide/
# on 2026-09-18) was never staged, so this hook would not have seen it. It closes
# the path where the drift gets committed here permanently. Run the script with
# -All to see the untracked half, which no commit-time check can reach.
run_gate doc-placement './scripts/checks/check-doc-placement.ps1' '' no \
    "Pre-commit validation failed (planning or journal material staged into the code repo)!"

# --- 3. gateway-only LLM routing -------------------------------------------
# Fail if any inference/serve endpoint points at a *-upstream real server
# instead of the LiteLLM gateway alias.
run_gate gateway-routing './scripts/checks/check-llm-gateway-routing.ps1' \
    './scripts/checks/check_llm_gateway_routing.py' yes \
    "Pre-commit validation failed (LLM gateway routing bypass)!"

# --- 3b. corpus write contract (DFU C.9 H3) --------------------------------
# Fail if a file INSERTs into `thoughts`/`agent_memories` over PostgREST without stating
# `exposure` at its own call site. Added 2026-08-31 after the exposure column's own
# post-condition ("every caller was found") turned out to have swept only the RPC callers:
# twelve DIRECT-table producers were never searched for, and one of them
# (openbrain-gmail-pull, daily) had been refused 42501 by the live policy since it landed.
#
# THE ENFORCEMENT IS THE DATABASE, NOT THIS CHECK, AND THIS COMMENT USED TO SAY OTHERWISE.
# It read "the gate DERIVES the producer set from the tree, so producer thirteen breaks the
# build instead of breaking production." That is FALSE and two verifiers refuted it: the gate
# derives its set only WITHIN the shapes it recognises, and a producer outside them is neither
# flagged nor counted. `195-` makes exposure NOT NULL + CHECKed on both tables and makes
# upsert_thought refuse a payload that omits it - THAT refuses an unlabelled write in every
# shape, from every language, forever. Producer thirteen, written in a shape this check cannot
# see, breaks PRODUCTION - and quietly, because the failing producers catch the 42501 and log
# a zero-row success.
#
# So this check is AUTHORING-TIME CONVENIENCE: it moves SOME of those refusals from 05:00 in a
# cron to `git commit`, which is worth having and is not coverage. It prints its own recognised
# shapes, its blind spots and the category of text that can clear a counted site on every run
# (`-ShowShapes` prints them alone). Read those before treating a green here as protection.
# Self-test: the script's -SelfTest switch.
run_gate corpus-exposure './scripts/checks/check-corpus-exposure-producers.ps1' '' no \
    "Pre-commit validation failed (a corpus insert does not state its plane)!"

# --- 4. project configs (staged-aware, K.8) ---------------------------------
# Any staged yml => render all compose projects against .env.example;
# any staged ps1 => PSParser tokenize. Skips itself when neither is staged.
run_gate project-configs './scripts/checks/check-project-configs.ps1' '' no \
    "Pre-commit validation failed (compose/ps1 structural check)!"

# --- 4b. generated doc blocks (inline sh + Python, ac-doc-generator, 2026-09-26)
# The service counts, profile sets, ports, plane table, product menu and probe
# list in the READMEs, the stack-map reference and SERVICE-LIFECYCLE.md are
# GENERATED between `stack:` markers by `python scripts/stack/stack.py docs
# --write`. This refuses a commit where one no longer matches the manifest and
# the compose renders, naming the block and the file - and where a registered
# block's markers are missing or broken, because a block that silently stops
# being generated is the failure this exists for.
#
# TRIGGER: a staged compose file (any *.yml / *.yaml), an .env.example, the
# manifest, stack.py, the OB1 gitlink, or one of the docs stack.py registers
# (`docs --list` - asked, not copied, so the trigger cannot drift from the
# registry). Anything else skips it without a render, so an ordinary commit
# costs nothing. The check reads the WORKING TREE, so once it triggers, ANY of
# those inputs carrying unstaged edits is refused outright - staged or not: an
# unstaged compose edit can make a stale staged block look current, and then
# what was checked is not what would be committed. (Not the OB1 gitlink here: a
# submodule reads as dirty for untracked files inside it. `docs --check` itself
# compares the OB1 checkout with the STAGED gitlink and its tracked edits, and
# reports every ob1 block NOT VERIFIED - never matched - when they differ.)
#
# EXIT CODES of `docs --check`, and what the hook does with each - FAIL-CLOSED:
#   0  every block matched                                  -> RAN
#   3  nothing it COMPARED was stale, but some blocks or rows -> SKIPPED, loudly
#      could not be rendered here (OB1 absent or not at the staged gitlink, a
#      gitignored env compose stats, no docker). Those were NOT compared; the
#      check names each one, and CI's stack-driver job (OB1 + docker, no
#      --allow-unverified) is the gate that compares them
#   1  a stale, missing or broken block                     -> REFUSED
#   anything else (a crash, a missing interpreter mid-run)  -> REFUSED
# Needs Python 3.11+ (tomllib), found independently of PS_HOST/PY_HOST like 0c's
# drift half; with none, SKIPPED and recorded in the summary and the ledger.
_docs_py=
for _cand in python3 python; do
    if command -v "$_cand" >/dev/null 2>&1 &&
       "$_cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
        _docs_py=$_cand
        break
    fi
done
if ! _docs_staged=$(git -c core.quotePath=false diff --cached --name-only); then
    echo "docs-blocks: git could not list the staged files - cannot tell whether a generated block went stale."
    echo "Pre-commit validation failed (generated doc blocks)!"
    print_summary
    exit 1
fi
if [ -z "$_docs_py" ]; then
    echo "SKIPPED docs-blocks: needs Python 3.11+ (a stale generated count in the docs would not be caught)"
    GATES_SKIPPED="$GATES_SKIPPED docs-blocks"
else
    if ! _docs_registered=$("$_docs_py" scripts/stack/stack.py docs --list); then
        echo "docs-blocks: \`stack.py docs --list\` failed - cannot tell which docs carry generated blocks."
        echo "Pre-commit validation failed (generated doc blocks)!"
        print_summary
        exit 1
    fi
    if ! _docs_dirty=$(git -c core.quotePath=false diff --name-only); then
        echo "docs-blocks: git could not list the unstaged changes - cannot tell what the check would read."
        echo "Pre-commit validation failed (generated doc blocks)!"
        print_summary
        exit 1
    fi
    # Tagged streams, not `awk -v` or process substitution: this is /bin/sh (dash
    # on Linux), and a path may contain spaces. Prints `S<tab>path` for a staged
    # input and `D<tab>path` for an unstaged one.
    _docs_inputs=$( { printf '%s\n' "$_docs_registered" | sed 's/^/R	/'
                      printf '%s\n' "$_docs_staged" | sed 's/^/S	/'
                      printf '%s\n' "$_docs_dirty" | sed 's/^/D	/'; } |
        awk -F'\t' '$1 == "R" { if ($2 != "") want[$2] = 1; next }
                    $2 != "" {
                        p = $2
                        if (p ~ /\.(yml|yaml)$/ || p ~ /(^|\/)\.env\.example$/ || p == "stack.manifest.toml" ||
                            p == "scripts/stack/stack.py" || (p in want) || ($1 == "S" && p == "OB1")) print $1 "\t" p }')
    _docs_trigger=$(printf '%s\n' "$_docs_inputs" | sed -n 's/^S	//p')
    _docs_unstaged=$(printf '%s\n' "$_docs_inputs" | sed -n 's/^D	//p')
    if [ -n "$_docs_trigger" ]; then
        if [ -n "$_docs_unstaged" ]; then
            echo "docs-blocks: these inputs of the generated doc blocks carry UNSTAGED edits, and the check reads the working tree:"
            printf '%s\n' "$_docs_unstaged" | sed 's/^/    /'
            echo "  Stage them, or stash them (git stash push --keep-index), then commit again."
            echo "Pre-commit validation failed (generated doc blocks)!"
            print_summary
            exit 1
        fi
        "$_docs_py" scripts/stack/stack.py docs --check
        _docs_rc=$?
        case "$_docs_rc" in
            0) GATES_RAN="$GATES_RAN docs-blocks" ;;
            3) echo "SKIPPED docs-blocks: the blocks and rows named NOT VERIFIED / PARTLY VERIFIED above were NOT compared on this machine and may be stale; everything else was current. CI's stack-driver job compares every block and refuses a stale one"
               GATES_SKIPPED="$GATES_SKIPPED docs-blocks" ;;
            *) echo "  Regenerate with: python scripts/stack/stack.py docs --write   (then stage the result)"
               echo "Pre-commit validation failed (generated doc blocks: stale, missing or broken - exit $_docs_rc)!"
               print_summary
               exit 1 ;;
        esac
    else
        GATES_RAN="$GATES_RAN docs-blocks"
    fi
fi

# --- 5. env_file scope (staged-aware) --------------------------------------
# Fail if this commit ADDS a service that grants itself a shared .env. Pre-existing
# grants are reported, not blocked - a guard that fails on old debt gets disabled.
run_gate env-file-scope './scripts/checks/check-env-file-scope.ps1' '' no \
    "Pre-commit validation failed (a service granted itself a shared .env)!"

# --- 5b. OB1 recipe tests on gitlink bumps ---------------------------------
# A gitlink bump IS the deploy of OB1 code to this stack (the live containers
# bind-mount OB1/recipes from this checkout), and the 08-28 wiki-pages bug
# shipped exactly there with its own catching test unrun (fixed 09f70f4 /
# 443c5d8). Skips itself instantly when no OB1 gitlink is staged.
run_gate ob1-recipe-tests './scripts/checks/check-ob1-recipe-tests.ps1' '' no \
    "Pre-commit validation failed (OB1 recipe tests failed for the staged gitlink)!"

# --- 5c. OB1 Deno recipe type-check on gitlink bumps -----------------------
# 5b above globs *.test.mjs. OB1/recipes/daily-digest is Deno TypeScript - .ts
# sources, a .test.ts test file - so until 2026-09-04 NOTHING in this chain
# compiled, type-checked or ran one line of it, while a gitlink bump deployed
# it to the live bind mounts all the same. Five defects shipped through that
# hole in the podcast-delivery week (08-29..09-03); one was `retryUntil` called
# without being imported, which would have aborted every production run, and
# `deno check` names it in about two seconds.
#
# TYPE CHECK ONLY - the recipe's deno test suite is slow and needs --allow-net,
# so a green here means "it compiles", not "it works". Skips instantly when no
# OB1 gitlink is staged; REFUSES (does not warn-and-pass) when deno is missing.
# The reasoning for both is in the script's header.
run_gate ob1-deno-recipes './scripts/checks/check-ob1-deno-recipes.ps1' '' no \
    "Pre-commit validation failed (OB1 Deno recipe does not type-check for the staged gitlink)!"

# --- 5d. OB1 integration images on gitlink bumps ---------------------------
# 5b runs recipe tests, 5c type-checks the Deno recipe - neither looks at a
# Dockerfile. OB1/integrations/research-curator crash-looped in production a
# day after its bump landed: index.ts had gained `./pool.ts`, the
# Dockerfile COPYs sources BY NAME and never listed it, `docker build` cannot
# fail on that, and "Module not found" surfaced at CONTAINER START. This gate
# refuses that at the commit: for every image-bearing integrations/<svc>/ the
# pin diff touches, the relative-import graph of the entrypoint must be
# covered by the Dockerfile's COPYs (seconds, no docker), then the image is
# built under a throwaway ob1-gate/<svc>:<sha7> tag and `deno check` runs
# inside it (--network none, never :local, tag removed after).
#
# Green means "the image builds and its module graph resolves" - NOT that the
# service starts against a real database or that env/compose wiring is right;
# the script header lists what it does not prove. Skips instantly when no OB1
# gitlink is staged or the bump touches no Dockerfile-bearing integration;
# REFUSES (does not warn-and-pass) when Docker is unreachable. pre-merge-commit
# execs this file, so a clean merge that bumps the gitlink gets it too.
run_gate ob1-integration-images './scripts/checks/check-ob1-integration-images.ps1' '' no \
    "Pre-commit validation failed (an OB1 integration image does not build or resolve for the staged gitlink)!"

# --- 6. ATTESTATION -------------------------------------------------------
# Record that these checks actually ran, because otherwise nobody can tell.
#
# WHY (PLAN 0 A7, FALSIFIED): an agent reached for `--no-verify` on its first
# commit, and `--no-verify` leaves NO trace in a git object - "the hooks ran" is
# unprovable from the repo afterwards. Normative rules ("never --no-verify") did
# not hold; containment has to be mechanical. So the hook leaves proof, and
# check-hook-attestation.ps1 reads it back.
#
# WE ATTEST THE TREE, not a commit sha - the commit does not exist yet, and the
# tree is the durable identity of the content. `git write-tree` on the current
# index yields exactly the tree the resulting commit will carry. Attesting the
# tree also means a rebase or cherry-pick that does not change content KEEPS its
# attestation, so the check does not fire on the reviewer's normal workflow. A
# guard that false-positives on legitimate work gets switched off, and then it
# protects nothing.
#
# AND WE ATTEST WHICH HOOK DID IT (2026-09-04). "The hooks ran" was never the
# question anyone actually had; the question is "did the hook that ran contain
# the check this evidence claims?". Those came apart on item wiki-mirror-
# hardening: three commits carried honest attestations written by a genuinely
# executing hook, and the hook executing was the PRE-5b one - the main checkout
# did not gain check 5b until 28 minutes after the last of them. Establishing
# that took a reviewer an hour of reflog archaeology, because the ledger
# recorded that A hook ran and nothing about WHICH.
#
# "$0" is the hook file git is executing RIGHT NOW. Not a path this script
# computed - that is the entire point. core.hooksPath is an absolute path to
# one checkout, so a worktree's own edited .githooks/pre-commit is NOT what
# runs for its commits; any path we derived from the repo would record the file
# we wish had run instead of the one that did. `git hash-object` on it yields
# the blob hash of that exact content, which is the same hash the file has in
# any commit that carries it - so `git cat-file -p <hash>` reads the hook back
# whenever that state was ever committed, and grepping it answers "was tree X
# gated by a hook containing check Y". A hash that resolves to nothing is also
# an answer: the gating hook was an uncommitted local edit. See .githooks/README.md.
#
# The lookup DEGRADES TO '?' and can never fail the commit - bookkeeping that
# can reject work gets switched off, and then none of this exists. Anything that
# is not a bare hex hash (an error message, an empty result, a git that cannot see
# the file) becomes '?' rather than corrupting the ledger's column layout.
#
# This runs LAST, after every check above has passed, so a rejected commit is
# never attested - attesting a tree the checks refused would launder it.
#
# The ledger lives in the SHARED git dir (--git-common-dir), never the worktree:
# it must not be committable, and every worktree of this repo must read one
# ledger, or a reviewer in another worktree could not verify a developer's work.
# It is APPEND-ONLY (>>): a line is a historical fact and is never rewritten.
_attest_tree=$(git write-tree 2>/dev/null)
if [ -n "$_attest_tree" ]; then
    _git_common=$(git rev-parse --git-common-dir 2>/dev/null)
    if [ -n "$_git_common" ]; then
        _attest_hook=$(git hash-object "$0" 2>/dev/null)
        case "$_attest_hook" in
            "" | *[!0-9a-f]* ) _attest_hook='?' ;;
        esac
        # FIFTH COLUMN, ONLY WHEN A GATE WAS SKIPPED (ac-hooks-portable). A host
        # with no PowerShell runs the Python twins and skips the rest; without
        # this column the line would read exactly like one from a host that ran
        # every gate, and the ledger would vouch for checks that never ran.
        # `skipped=<gate>,<gate>`; absent when nothing was skipped, so a Windows
        # line keeps its four columns. Readers split on whitespace and read
        # columns 1 and 4 only, so a fifth column changes no verdict.
        _attest_skipped=
        if [ -n "$GATES_SKIPPED" ]; then
            _attest_skipped=" skipped=$(echo $GATES_SKIPPED | tr ' ' ',')"
        fi
        printf '%s %s %s %s%s\n' \
            "$_attest_tree" \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')" \
            "$_attest_hook" \
            "$_attest_skipped" \
            >> "$_git_common/hook-attest.log" 2>/dev/null || true
    fi
fi

print_summary
echo "Pre-commit validations passed!"
exit 0
