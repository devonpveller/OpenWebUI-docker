#!/bin/sh
# Pre-commit hook - VERSION CONTROLLED (see .githooks/README.md)
#
# Activate in a fresh clone with:
#   git config core.hooksPath .githooks
#
# Checks, in order of how cheap they are:
#   1. secret guard      - staged-only scan; blocks env files + provider tokens
#   2. line endings      - repo convention
#   3. gateway routing   - inference must go through the LiteLLM alias
#   4. project configs   - compose renders + ps1 tokenize
#   5. env_file scope    - a service names the variables it needs

echo "Running pre-commit validations..."

# --- 1. secrets (staged content only, so it stays fast) --------------------
# Added 2026-08-20 after two .env.bak-* files reached a commit and were only
# stopped at push time by GitHub push protection - which matched 2 GitHub PATs
# while each file held ~25 live credentials. Catch it at commit time instead.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File './scripts/checks/check-staged-secrets.ps1'
if [ $? -ne 0 ]; then
    echo "Pre-commit validation failed (secret detected in staged files)!"
    exit 1
fi

# --- 2. line endings -------------------------------------------------------
powershell.exe -NoProfile -ExecutionPolicy Bypass -File './scripts/checks/validate-lineendings.ps1'
if [ $? -ne 0 ]; then
    echo "Pre-commit validation failed (line endings)!"
    exit 1
fi

# --- 3. gateway-only LLM routing -------------------------------------------
# Fail if any inference/serve endpoint points at a *-upstream real server
# instead of the LiteLLM gateway alias.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File './scripts/checks/check-llm-gateway-routing.ps1'
if [ $? -ne 0 ]; then
    echo "Pre-commit validation failed (LLM gateway routing bypass)!"
    exit 1
fi

# --- 4. project configs (staged-aware, K.8) ---------------------------------
# Any staged yml => render all compose projects against .env.example;
# any staged ps1 => PSParser tokenize. Skips itself when neither is staged.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File './scripts/checks/check-project-configs.ps1'
if [ $? -ne 0 ]; then
    echo "Pre-commit validation failed (compose/ps1 structural check)!"
    exit 1
fi

# --- 5. env_file scope (staged-aware) --------------------------------------
# Fail if this commit ADDS a service that grants itself a shared .env. Pre-existing
# grants are reported, not blocked - a guard that fails on old debt gets disabled.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File './scripts/checks/check-env-file-scope.ps1'
if [ $? -ne 0 ]; then
    echo "Pre-commit validation failed (a service granted itself a shared .env)!"
    exit 1
fi

# --- 6. ATTESTATION -> MOVED TO .githooks/commit-msg (2026-08-30) ----------
# It used to be written HERE, and being first in the chain was the defect.
#
# pre-commit runs BEFORE commit-msg. A tree attested here survived a commit-msg refusal,
# so an agent whose message was rejected for naming a gitlink SHA that does not exist
# could re-run the identical commit with --no-verify and land it - past the guard and
# without a guard-log line. Reproduced by execution, not reasoned about; the transcript
# and the fix are in .githooks/attest-lib.sh.
#
# Attestation is now the LAST thing the LAST veto hook does, and it records the message
# as well as the tree. Nothing to do here: reaching the attester requires passing every
# check above, because --no-verify skips this hook and commit-msg together.

echo "Pre-commit validations passed!"
exit 0
