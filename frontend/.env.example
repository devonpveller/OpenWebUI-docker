# ===========================================================================
# frontend/.env.example - the FRONTEND plane's own environment
# (stack-layers L.2 / D10 / D17, 2026-09-19)
# ===========================================================================
# Copy to `frontend/.env` and fill in. Compose loads it NATIVELY: passing
# `-f frontend/docker-compose.yml` makes `frontend/` the PROJECT DIRECTORY, and
# compose reads the `.env` sitting there. No `--env-file` flag, from any working
# directory - which is why the guards in the compose file name THIS file.
#
# THE SPLIT RULE (D10): a variable lives in the .env of the plane whose service
# reads it. A value two planes read is DECLARED IN EACH - the plane files are
# independent and compose cannot reference one from another. Every such case
# below says so by name.
#
# WHAT IS IN HERE: exactly the variables `frontend/docker-compose.yml`
# interpolates, under every profile (stock / gpu / tailscale). A variable here
# that no file in this plane reads, or a `${VAR}` in the plane that has no line
# here, is a two-way-diff failure - see
# ../documentation-plans-ai-stack/journal/evidence/sl-env-split/test-plan.md.
#
# The root `.env` is NOT read by this plane any more. If you are migrating an
# existing deployment, follow documentation/runbooks/env-split-migration.md:
# write the plane files first, verify each renders, and only then trim the root.

# ---------------------------------------------------------------------------
# COMPOSE_PROFILES - THIS PLANE'S profiles, and only this plane's (D17)
# ---------------------------------------------------------------------------
# It used to be one global assignment in the root .env, because every plane was
# driven with `--env-file .env` and therefore read the same value (each project
# ignoring names it does not declare). Now each project loads its OWN file, so
# the variable belongs here, carrying the frontend's profiles alone.
#
# A duplicate key in one env file is LAST-WINS, silently, exit 0 (measured
# against compose v5.3, 2026-09-19). So there is exactly ONE assignment per
# file. Do not add a second one further down.
#
# A `--profile` flag on the command line REPLACES this value for that
# invocation rather than adding to it (measured; sl-driver-parity). The driver
# (scripts/stack/stack.py, effective_profiles()) unions this value into any
# flags it passes, for exactly that reason.
#
# THE PROFILES:
#   stock      Open WebUI alone: pinned upstream image, no GPU, no local build,
#              no tailscale, no other plane. What a fresh clone runs.
#   gpu        the CUDA local build + the nvidia device reservation +
#              USE_CUDA/NVIDIA_* + the llm-net / app-net seams + the status-pipe
#              mount. Needs an NVIDIA container runtime. Mutually exclusive with
#              `stock`: both define container_name openwebui, and turning on
#              both is refused by `docker compose config` before anything
#              starts.
#   tailscale  the tailnet node welded to openwebui's netns, and its state
#              backup. Usable ONLY together with `gpu`.
#
# THE TWO CANONICAL VALUES:
#   a fresh clone .................. COMPOSE_PROFILES=stock
#   the operator's GPU deployment .. COMPOSE_PROFILES=gpu,tailscale
#
# ON A GPU HOST THE FULL VALUE IS REQUIRED, NOT ADVISORY. Without the
# frontend's profiles at all:
#   `up -d`   starts openwebui-backup and nothing else;
#   `down`    LEAVES openwebui and tailscale running (compose only tears down
#             services whose profile is active);
#   any verb NAMING tailscale (up/stop/start/restart/rm/ps/config, and
#             --no-deps too) exits 1 with `no such service: openwebui`, because
#             naming a service activates only ITS profile and tailscale's
#             network_mode/depends_on point at the gpu-profiled openwebui.
# So the watchdog's tailscale self-heal and emergency-recovery.ps1 are dead
# until this line is right, silently. Verify with
# scripts\checks\check-watchdog-repair-targets.ps1 after editing.
#
# `stock` is what ships here: this file is what a first-time clone copies and
# what the pre-commit compose check renders the plane against.
COMPOSE_PROFILES=stock

# --- Open WebUI -------------------------------------------------------------
# Image for the `stock` profile only (the `gpu` profile builds and uses
# openwebui:local). Uncomment to pin a different upstream release; the default
# below is what frontend/docker-compose.yml falls back to.
#OWUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

# Encrypts values at rest in webui.db. Pin once; a rotate breaks every
# encrypted credential + all sessions. (Placeholder value on purpose: this var
# carries a ${...:?} fail-loud guard in frontend/docker-compose.yml, and an
# EMPTY value trips it - which would break the CI compose validation.)
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# OWUI's own LiteLLM virtual key (J.1) - injected into the openwebui container
# for the status-pipe queue board. Issue it via llm-gateway-ui /key/generate;
# the INFERENCE plane holds the master key that mints it (inference/.env).
OWUI_CHAT_LLM_API_KEY=sk-change-me-owui-virtual-key

# GPU routing for the openwebui CUDA build (`gpu` profile). DECLARED IN BOTH
# PLANES by D10: the inference plane has its own GPU_LLAMA_CPP_* indices in
# inference/.env, and they are separate values for separate services.
# Use: nvidia-smi --query-gpu=index,name --format=csv
# Set by index (0, 1, ...) or GPU UUID (GPU-xxxxxxxx-...).
GPU_AISTACK_DEVICE_ID=1

# --- Opt-in LAN binding (edge-b2-pub, cluster-transition 5.1 item B2) ----------
# Publishes Open WebUI on <OWUI_LAN_IP>:3000 BESIDE the 127.0.0.1:3000 line, for
# the Proxmox Traefik (Authentik in front of it). Both openwebui definitions
# (stock and gpu) carry it. Rules:
#   * ONE SPECIFIC LAN ADDRESS of this host (192.0.2.10 is a placeholder) - NEVER 0.0.0.0.
#     0.0.0.0 would listen on every interface, and beside the loopback line it
#     makes the recreate FAIL ("failed to bind host port 127.0.0.1:...: address
#     already in use", measured on Docker Desktop 2026-10-16), so the container
#     does not start at all. `python scripts/checks/check_lan_bindings.py
#     --live-env` refuses anything that is not one IPv4 unicast address.
#   * B1 FIRST: apply the LAN firewall guard (cluster-transition item B1,
#     `-Apply`) so only the Proxmox nodes reach the port, BEFORE setting this.
#   * Unset or empty = nothing new listens anywhere (the shipped state).
#   * Takes effect only on a RECREATE (`stack.py up <plane>` / `docker compose
#     up -d`); `docker compose restart` keeps the old port bindings.
#   * RECREATE ORDER: openwebui first, wait until it is healthy, THEN tailscale
#     (it shares openwebui's network namespace). Never recreate openwebui alone.
#OWUI_LAN_IP=192.0.2.10

# --- Opt-in: keep SSO settings entered in the admin UI (edge-b3-oauth, B3) -------
# Open WebUI 0.11.0 saves and reads `oauth.*` login settings (role mapping, sign-up,
# merge by email) in webui.db ONLY when ENABLE_OAUTH_PERSISTENT_CONFIG=true; otherwise
# settings typed into the admin UI are not kept. It does NOT create the login provider
# (the SSO button): that comes only from the OIDC variables in the next section. Both openwebui definitions (stock and gpu) pass this
# variable through to it. Off (false) as shipped = exactly today's behaviour.
#   * What it changes: UI-entered SSO settings, INCLUDING the client secret, are stored
#     in webui.db (covered by the openwebui-backup of that volume), and OAuth values in
#     the environment then no longer override them.
#   * Preconditions before you turn it on:
#       - the Authentik `roles` scope mapping is attached to the provider and checked
#         in the provider's Preview;
#       - a SECOND local admin with a DIFFERENT email exists as break-glass: role
#         management re-derives the role of the merged admin account on every SSO login.
#   * Only the word `true` (any case) enables it; any other value (1, yes, on) leaves it off.
#   * Takes effect only on a RECREATE, not an image rebuild or `docker compose restart`.
#   * RECREATE ORDER: openwebui first, wait until it is healthy, THEN tailscale
#     (it shares openwebui's network namespace). Never recreate openwebui alone.
#OWUI_OAUTH_PERSISTENT_CONFIG=true

# --- Opt-in: OIDC login provider, the SSO button (edge-b3-oidc) -------------------
# Open WebUI 0.11.0 registers its OIDC provider once at startup ONLY from these
# variables; values saved in the admin UI are not used for that. Both openwebui
# definitions pass them through. Unset = OWUI's own defaults = no SSO button.
#   * OPENID_PROVIDER_URL is the discovery URL the BROWSER can also reach (login
#     redirects go through the browser), e.g. Authentik:
#     https://<authentik host>/application/o/<app slug>/.well-known/openid-configuration
#   * OAUTH_SCOPES must include any custom scope your role mapping needs (e.g. `roles`).
#   * The client secret lives ONLY in frontend/.env (gitignored); never in this file.
#   * Takes effect only on a RECREATE; order: openwebui, wait healthy, then tailscale.
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
#OPENID_PROVIDER_URL=https://idp.example.invalid/application/o/open-webui/.well-known/openid-configuration
#OAUTH_PROVIDER_NAME=SSO
#OAUTH_SCOPES=openid email profile

# --- OpenWebUI feature flags -------------------------------------------------
ENABLE_CODE_INTERPRETER=False
ENABLE_CODE_EXECUTION=False

# --- Open WebUI web-search wiring (Approach B - stock searxng engine -> the
# search plane's gateway). The gateway itself is configured in search/.env;
# these three only tell OWUI where to send the query.
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://gateway:8080/search?q=<query>

# --- tailscale (`tailscale` profile) -----------------------------------------
# create a new key here:
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=putyourtskeyhere

# --- tailscale serve routes: llama.cpp (tailscale entrypoint) ----------------
# HOSTS, not backends: these name services on OTHER planes that the tailnet node
# proxies to. They are the frontend's view of them, so they live here.
LLAMA_CPP_ENABLED=true
LLAMA_CPP_HOST=llama-cpp
LLAMA_CPP_PORT=8080
LLAMA_CPP_EMBED_ENABLED=true
LLAMA_CPP_EMBED_HOST=llama-cpp-embed
LLAMA_CPP_EMBED_PORT=8080

# --- tailscale serve routes: open_notebook / Quartz --------------------------
OPEN_NOTEBOOK_ENABLED=true
OPEN_NOTEBOOK_HOST=open_notebook
OPEN_NOTEBOOK_PORT=8502
OPEN_NOTEBOOK_TS_PORT=8443
OPEN_NOTEBOOK_API_PORT=5055
OPEN_NOTEBOOK_API_TS_PORT=5055
QUARTZ_ENABLED=true
QUARTZ_HOST=caddy
QUARTZ_PORT=8446
QUARTZ_TS_PORT=8444

# --- Backup sidecars ---------------------------------------------------------
# *_BACKUP_RETAIN_COUNT is a COUNT (how many most-recent archives to keep), not
# days. Default 2 = ~2 nightly snapshots local; the weekly NAS sync gives you
# ~2 additional copies per NAS slot.
#
# No cron variable exists for either sidecar: both are sleep-loop sidecars,
# scheduled by the *_BACKUP_INTERVAL seconds below
# (frontend/docker-compose.yml:444 and :508).
OPENWEBUI_BACKUP_RETAIN_COUNT=2
OPENWEBUI_BACKUP_INTERVAL=86400
TAILSCALE_BACKUP_RETAIN_COUNT=2
TAILSCALE_BACKUP_INTERVAL=86400
