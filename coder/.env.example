# ===========================================================================
# coder/.env.example - the CODER plane's own environment
# (stack-layers L.2 / D10 / D17, 2026-09-19)
# ===========================================================================
# little-coder control plane: open-terminal (executor), little-coder (daemon),
# lc-egress, little-coder-backup.
# Docs: ../documentation-plans-ai-stack/implementation-guide/little-coder/
#
# Copy to `coder/.env` and fill in. Compose loads it NATIVELY: passing
# `-f coder/docker-compose.yml` makes `coder/` the PROJECT DIRECTORY, and
# compose reads the `.env` sitting there. No `--env-file` flag, from any
# working directory - which is why the guard in the compose file names THIS
# file.
#
# THE SPLIT RULE (D10): a variable lives in the .env of the plane whose service
# reads it. A value two planes read is DECLARED IN EACH - the plane files are
# independent and compose cannot reference one from another.
#
# WHAT IS IN HERE: exactly the variables `coder/docker-compose.yml`
# interpolates, plus the two OPERATOR ACTION ITEMS at the bottom that this
# plane's later chapters will consume. This plane declares NO compose profiles,
# so there is no COMPOSE_PROFILES line (D17).
#
# Migrating an existing deployment: documentation/runbooks/env-split-migration.md.

# ---------------------------------------------------------------------------
# open-terminal - workspace plane API key. Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Carries a ${...:?} fail-loud guard in coder/docker-compose.yml.
#
# ALSO HELD BY THE FRONTEND, per D10: the OWUI Terminal-server wiring uses the
# same key (frontend/docker-compose.yml:241, currently a commented-out
# TERMINAL_SERVER_CONNECTIONS line - so nothing in the frontend interpolates it
# TODAY and frontend/.env.example deliberately does not carry it; uncommenting
# that line means adding the variable to frontend/.env at the same time).
OPEN_TERMINAL_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# little-coder - self-improving coding agent (Chapter 1: Tool)
# ---------------------------------------------------------------------------
# Pin the upstream little-coder version for reproducible builds (plan §5).
# Pin a concrete version - never `latest` (it floats; a rebuild silently jumps).
LITTLE_CODER_VERSION=1.9.7

# Route the agent's command execution into open-terminal via the bash-override
# pi extension (design §3.4). 1 = route to open-terminal (default, verified);
# 0 = built-in bash, runs in the network-isolated little-coder container.
# See little-coder/pi-extension/README.md.
LC_ROUTE_EXEC=1

# little-coder's own LiteLLM virtual key for its inference (J.1). Issued by the
# INFERENCE plane's llm-gateway-ui /key/generate; the master key that mints it
# lives in inference/.env. This is the consumer's own copy, per D10.
# (llama-swap itself accepts any value.)
LC_LLAMA_API_KEY=llama

# Per-repo deploy token for cloning private work repos (design §10.3):
# least-privilege, HTTPS token, never the self-improvement PAT. Empty = public.
LC_DEPLOY_TOKEN=

# Backup retention for the little-coder expertise volumes (a COUNT of
# most-recent archives, not days). No cron variable exists: little-coder-backup
# is a sleep-loop sidecar, scheduled by LITTLE_CODER_BACKUP_INTERVAL seconds
# (coder/docker-compose.yml:182).
LC_BACKUP_RETAIN_COUNT=2
LITTLE_CODER_BACKUP_INTERVAL=86400

# ---------------------------------------------------------------------------
# OPERATOR ACTION ITEMS - required before the self-improvement chapters.
# ---------------------------------------------------------------------------
# NO READER TODAY: swept 2026-09-19 (sl-env-split), these two names appear in
# no compose file, script or source in this repo. They are kept because the
# chapters that consume them are designed and the chain should not be
# retrofitted; they are HERE rather than in the root because the plane that
# will read them is this one.
#   1. Create a PRIVATE self-improvement git remote (design §10.6).
#   2. Provision a fine-grained PAT scoped to contents:write on it ONLY -
#      no repo deletion, no admin, no other repos.
# Also: add your git remote's host to little-coder/docker/egress-allowlist.txt.
LC_SELF_REMOTE_URL=
LC_SELF_REMOTE_PAT=
