{
  "mcpServers": {
    "docker-gateway": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    },
    "openbrain": {
      "type": "http",
      "url": "http://127.0.0.1:8061/mcp",
      "headers": {
        "Authorization": "Bearer ${env:OPENBRAIN_GATEWAY_KEY}"
      }
    }
  }
}
