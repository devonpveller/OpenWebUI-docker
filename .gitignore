# .gitignore
.env
.env.killswitch-*.bak
# Any .env backup, however named. 2026-08-20: .env.bak-pre-mtp and
# .env.bak-pre-qwen38 were committed and GitHub push-protection caught two
# GitHub PATs in them -- but each file held ~25 live credentials (Authelia
# keys, Cloudflare tunnel token, Mullvad WG private key, Tailscale auth key,
# bot tokens, DB passwords). Only the PATs were pattern-matchable, so the
# block was luck. Never let an .env copy near the index again.
.env.bak*
.env.*.bak
.env-bak*
*.env.bak*
data/
logs/
data-backup/
backups/
# Tailscale runtime logs (keep tailscaled.log.conf, drop rotated logs)
tailscale-state/*.txt
tailscale-state/*.log*
# Use glob form so the `!backup/<script>.sh` re-includes below work.
# (Git won't re-include files inside an excluded *directory*, but it WILL
# re-include files matched by an excluded *glob*.)
backup/*
__pycache__/
# Local MCP configs (contain the Open Brain access key)
.mcp.json
.vscode/mcp.json
# OB1/ is a git submodule (H.1, 2026-08-21) - tracked via .gitmodules, not ignored
# Deploy keys / mounted secrets (e.g. openbrain-wiki private remote key)
secrets/
*.pyc
*.log
/backups

# --- Re-include backup scripts under backup/ that ARE meant to be tracked ---
# The `backup/` line above hides everything; selectively un-ignore the scripts
# the plan ships. Generated tarballs / restore artifacts stay ignored.
!backup/mnemory-backup.sh
!backup/mnemory-restore.sh
!backup/openwebui-backup.sh
!backup/openwebui-restore.sh
!backup/little-coder-backup.sh
!backup/caddy-backup.sh
!backup/authelia-backup.sh
!backup/llm-gateway-backup.sh
!backup/generic-tar-backup.sh
!backup/pg-backup.sh
# (openbrain-db/wiki + open-notebook backup scripts and their Dockerfiles
#  moved to OB1/docker/backup/ 2026-08-21 — OB1 owns its own backup sidecars.)
# Sidecar build contexts (compose builds ./backup with these) — must be tracked
# or a fresh clone cannot build the postgres/surreal/generic backup sidecars.
!backup/Dockerfile

# --- Portal-specific paths from plan §7.2 ---
config/authelia/users_database.yml
config/tripwire/baseline.sha256
config/alerter/credentials.json
# Incident-response snapshot directories produced by breach-killswitch.ps1
/incident/
/reports
config/alerter/token.json

# Claude Code Mattermost notifier — per-session allowlist (machine-specific runtime state)
scripts/.mm-notify-sessions
.claude/settings.local.json

# Claude-Sessions bridge runtime state (session map, audit logs, per-turn MCP configs)
scripts/claude-sessions-bridge/state/

# sysadmin-mcp runtime state (audit log, compaction result)
scripts/sysadmin-mcp/state/
scripts/sysadmin-mcp/bridge-state/
# Telegram out-of-band listener runtime state (getUpdates offset, command audit)
scripts/sysadmin-mcp/telegram-state/
*.egg-info/
.env.test
documentation/issue-plans/

# Per-agent worktrees (worktree-per-session, 2026-08-28). Each is a full checkout
# created by scripts/worktree/new-worktree.ps1 and carries COPIES of .env* - it must
# never be committed, and it must never be scanned as if it were repo content.
.claude/worktrees/
# (Worktree/queue/lease state used to live in scripts/worktree/state/ and needed an ignore
# rule. It now lives in <git-common-dir>/agent-worktrees/ so every worktree shares ONE
# namespace - inside .git, which is never tracked, so no rule is needed.)
