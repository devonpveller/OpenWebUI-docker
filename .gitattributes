# Git attributes for consistent line endings across platforms

# Shell scripts should always use LF line endings (Unix style)
*.sh text eol=lf
entrypoint.sh text eol=lf
# Git hooks are shell scripts with NO .sh extension, so they miss the rule
# above. CRLF would break them under Git Bash ("$'': command not found").
.githooks/* text eol=lf

# Docker files should use LF
Dockerfile* text eol=lf
dockerfile* text eol=lf

# Docker Compose files should use LF
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
# A plane's compose file split by service group (inference/compose/*.yml since
# 2026-09-19) needs the SAME rule: lm-models-backup carries a multi-line shell
# script under `command:`, and a CRLF checkout would hand `sh -c` a literal .
*/compose/*.yml text eol=lf

# Other text files that should be consistent
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf

# PowerShell scripts can use CRLF on Windows
*.ps1 text eol=crlf

# Authelia REWRITES this tracked file on every start. portal/docker-compose.yml
# binds it as a FILE (`./config/authelia/.healthcheck.env:/app/.healthcheck.env`),
# so it cannot simply be untracked and ignored: docker would create a DIRECTORY
# in its place on a fresh clone and Authelia's read-only root would fail on the
# write. It has to exist in the tree, and the container has to be free to
# overwrite it.
#
# The drift was PURE LINE ENDINGS (verified 2026-09-21: the worktree blob and the
# index blob hash identically at 9c1d75f9, 190 bytes each). core.autocrlf=true
# checks the file out as CRLF, Authelia - a Linux process - writes it back as LF,
# and `git status` has shown it modified after every portal start ever since.
# Pinning eol=lf makes the checked-out bytes the bytes Authelia writes, so the
# main checkout stays clean. It stays `text` rather than `-text` so a real
# content change (a port, a scheme) is still a readable diff.
portal/config/authelia/.healthcheck.env text eol=lf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
