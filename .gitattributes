# Git attributes for consistent line endings across platforms

# Shell scripts should always use LF line endings (Unix style)
*.sh text eol=lf
entrypoint.sh text eol=lf
# Git hooks are shell scripts with NO .sh extension, so they miss the rule
# above. CRLF would break them under Git Bash ("$'': command not found").
.githooks/* text eol=lf

# Docker files should use LF
Dockerfile* text eol=lf
dockerfile* text eol=lf

# Docker Compose files should use LF
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
# A plane's compose file split by service group (inference/compose/*.yml since
# 2026-09-19) needs the SAME rule: lm-models-backup carries a multi-line shell
# script under `command:`, and a CRLF checkout would hand `sh -c` a literal .
*/compose/*.yml text eol=lf

# Other text files that should be consistent
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf

# PowerShell scripts can use CRLF on Windows
*.ps1 text eol=crlf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
