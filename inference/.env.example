# ===========================================================================
# inference/.env.example - the INFERENCE plane's own environment
# (stack-layers L.2 / D10 / D17, 2026-09-19)
# ===========================================================================
# Copy to `inference/.env` and fill in. Compose loads it NATIVELY: passing
# `-f inference/docker-compose.yml` makes `inference/` the PROJECT DIRECTORY,
# and compose reads the `.env` sitting there. No `--env-file` flag, from any
# working directory - which is why the guards in the compose files name THIS
# file.
#
# THE SPLIT RULE (D10): a variable lives in the .env of the plane whose service
# reads it. A value two planes read is DECLARED IN EACH - the plane files are
# independent and compose cannot reference one from another.
#
# WHAT IS IN HERE: exactly the variables the inference project interpolates -
# `inference/docker-compose.yml` plus everything it `include:`s
# (compose/upstreams.yml, queue.yml, gateway.yml, backups.yml) - under every
# profile. A variable here that no file in this plane reads, or a `${VAR}` in
# the plane with no line here, is a two-way-diff failure; see
# ../documentation-plans-ai-stack/journal/evidence/sl-env-split/test-plan.md.
#
# Migrating an existing deployment: documentation/runbooks/env-split-migration.md.

# ---------------------------------------------------------------------------
# COMPOSE_PROFILES - THIS PLANE'S profiles, and only this plane's (D17)
# ---------------------------------------------------------------------------
# The inference plane declares exactly one profile:
#
#   local   llama-cpp-upstream, llama-cpp-embed-upstream, llm-queue and
#           lm-models-backup - the GPU backends. With it OFF the project is a
#           LiteLLM gateway + ledger + Admin UI only, which is what a machine
#           with no GPU runs. THE OPERATOR'S DEPLOYMENT NEEDS IT ON.
#
# SET IT HERE, do not pass `--profile local`: llm-gateway reads COMPOSE_PROFILES
# itself (inference/compose/gateway.yml:115) to decide which model groups
# assemble-config.py registers, so the CLI flag alone starts the local backends
# WITHOUT listing their models. A `--profile` flag also REPLACES this value
# rather than adding to it (measured, compose v5.3, 2026-09-19), which is why
# scripts/stack/stack.py unions this line into any flags it passes.
#
# A duplicate key in one env file is LAST-WINS, silently, exit 0. Exactly one
# assignment per file.
#
# SHIPPED COMMENTED OUT, deliberately: this file is what the pre-commit compose
# check and CI render the plane against, and the cloud-only render (the state a
# machine with no GPU is in) would be untestable with `local` on. A GPU host
# uncomments it.
#COMPOSE_PROFILES=local

# --- GPU device mapping ------------------------------------------------------
# Use: nvidia-smi --query-gpu=index,name --format=csv
# Set by index (0, 1, ...) or GPU UUID (GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
# The frontend plane has its own GPU_AISTACK_DEVICE_ID in frontend/.env - a
# separate value for a separate service, per D10.
GPU_LLAMA_CPP_DEVICE_ID=0
GPU_LLAMA_CPP_EMBED_DEVICE_ID=1

# --- Where the GGUFs live ----------------------------------------------------
# Host directory holding the llama.cpp GGUF store, bind-mounted read-only into
# llama-cpp-upstream (/models) and lm-models-backup (/data). A RELATIVE path
# resolves against inference/compose/ (the directory of the files that mount
# it), NOT the repo root - so the value below is <repo>/data/models/gguf, which
# is gitignored. It is also the compose default when the line is absent
# (deliberately a `:-` default and not a `:?` guard, so a cloud-only node does
# not have to set a variable only the profiled services use). Put your GGUFs
# there, or set an ABSOLUTE path to an existing store (e.g. /srv/models/gguf,
# or D:/models on Windows). An empty store is the 2026-09-19 outage: llama-swap
# answers /health and then 500s the first completion - `stack.py health` checks.
LM_MODELS_DIR=../../data/models/gguf

# --- llama.swap model defaults for the llama-cpp service ---------------------
# Select model via request model id: qwen36-35b-a3b or qwen36-27b
LLAMA_CPP_CACHE_TYPE_K=q4_0
LLAMA_CPP_CACHE_TYPE_V=q4_0
LLAMA_CPP_TIMEOUT=300
LLAMA_ARG_CTX_CHECKPOINTS=8

# Qwen 3.6 35B-A3B profile (currently active)
LLAMA_SWAP_QWEN36_35B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_35B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_35B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_35B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_35B_BATCH=1024
LLAMA_SWAP_QWEN36_35B_UBATCH=512
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_35B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_35B_REASONING_BUDGET=4096

# Qwen 3.6 27B profile (download model and adjust path if needed)
LLAMA_SWAP_QWEN36_27B_MODEL_PATH=/models/lmstudio-community/Qwen3.6-27B-GGUF/Qwen3.6-27B-Q4_K_M.gguf
LLAMA_SWAP_QWEN36_27B_CTX_SIZE=262144
LLAMA_SWAP_QWEN36_27B_N_GPU_LAYERS=99
LLAMA_SWAP_QWEN36_27B_N_PARALLEL=1
LLAMA_SWAP_QWEN36_27B_BATCH=1024
LLAMA_SWAP_QWEN36_27B_UBATCH=512
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_K=q4_0
LLAMA_SWAP_QWEN36_27B_CACHE_TYPE_V=q4_0
LLAMA_SWAP_QWEN36_27B_REASONING_BUDGET=4096

# llama-swap speculative decoding (qwen36-27b MTP)
LLAMA_SWAP_QWEN36_27B_SPEC_TYPE=draft-mtp
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_N_MAX=8
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_CACHE_TYPE_K=q8_0
LLAMA_SWAP_QWEN36_27B_SPEC_DRAFT_CACHE_TYPE_V=q8_0

# --- llm-queue (B2 admission controller) -------------------------------------
# LLM_QUEUE_SLOTS MUST track LLAMA_SWAP_QWEN36_27B_N_PARALLEL above
# (inference/compose/queue.yml:75-76).
LLM_QUEUE_SLOTS=3
LLM_QUEUE_MAX_IN_FLIGHT=4
LLM_QUEUE_ENFORCE_BUDGET=true
LLM_QUEUE_EVENTS_DB_PATH=/data/events.db
LLM_QUEUE_BACKSTOP_DEPTH=24
LLM_QUEUE_LOG_LEVEL=INFO
LLM_QUEUE_MAX_TOTAL_CONNECTIONS=128
LLM_QUEUE_T_INITIAL_S=30
LLM_QUEUE_T_WINDOW=5
LLM_QUEUE_UPSTREAM_TIMEOUT_S=600

# ---------------------------------------------------------------------------
# LiteLLM gateway - the front door (guide §1A, added 2026-06-12)
# Docs: ../documentation-plans-ai-stack/implementation-guide/LiteLLM-Proxy/guide-LiteLLM-Proxy.md
# ---------------------------------------------------------------------------
# Internal Postgres password for llm-gateway-db (reachable only on the internal
# llm-net). Generate: a long random hex string. Carries a ${...:?} fail-loud
# guard in inference/compose/gateway.yml, so it must not be empty.
LITELLM_DB_PASSWORD=change-me-to-a-long-random-string

# J.1 (2026-08-21): the gateway ENFORCES per-caller virtual keys -
# `master_key: os.environ/LITELLM_MASTER_KEY` under general_settings in
# inference/config/litellm.config.yaml. REQUIRED: leaving it blank is a 401 for
# every caller. Issue per-caller sk- keys via llm-gateway-ui /key/generate (see
# LiteLLM-Proxy/J1-VIRTUAL-KEYS-CUTOVER.md). The CALLERS hold their own copies
# in their own plane files - OWUI_CHAT_LLM_API_KEY (frontend/.env),
# LC_LLAMA_API_KEY (coder/.env).
LITELLM_MASTER_KEY=

# LiteLLM Admin-UI sidecar (llm-gateway-ui, tailnet :8445/ui)
LITELLM_UI_MASTER_KEY=
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=

# Opt-in LAN binding for the Admin UI (edge-b2-pub, cluster-transition 5.1
# item B2): publishes llm-gateway-ui on <LITELLM_UI_LAN_IP>:8445 (container
# 8080), for the Proxmox Traefik (Authentik in front of it). The UI has no
# loopback port today and gets none; inference/docker-compose.yml switches
# compose/gateway-lan-on.yml in only while this is non-empty. llm-gateway, the
# inference gateway itself, never gets a port from this. Rules:
#   * ONE SPECIFIC LAN ADDRESS of this host (192.0.2.10 is a placeholder) - NEVER 0.0.0.0.
#     This UI has NO loopback line, so unlike Open WebUI and Mattermost 0.0.0.0
#     would NOT fail: the container would start and listen on EVERY interface.
#     Never use it. `python scripts/checks/check_lan_bindings.py
#     --live-env` refuses anything that is not one IPv4 unicast address.
#   * STATIC OR DHCP-RESERVED: the address must be one this host holds at boot. If it
#     is not assigned when the container starts (a DHCP lease that moved, an
#     interface still coming up), the bind fails and the container does not start
#     at all (this UI has no loopback line to fall back on).
#   * B1 FIRST: apply the LAN firewall guard (cluster-transition item B1,
#     `-Apply`) so only the Proxmox nodes reach the port, BEFORE setting this.
#   * Unset or empty = nothing new listens anywhere (the shipped state).
#   * Takes effect only on a RECREATE (`stack.py up <plane>` / `docker compose
#     up -d`); `docker compose restart` keeps the old port bindings.
#LITELLM_UI_LAN_IP=192.0.2.10

# --- Opt-in: Authentik SSO for the LiteLLM Admin UI (edge-litellm-sso) ----------
# llm-gateway-ui ONLY (the inference gateway itself never sees these). LiteLLM reads
# them from the environment and treats a variable that EXISTS as configured, even
# when empty - so leave a line OUT entirely (commented) rather than setting it empty;
# an empty GENERIC_CLIENT_ID switches SSO on and breaks the UI_USERNAME login.
#   * Authentik endpoints are fixed paths on the Authentik host (example names; the
#     `.lab` names are the local lane and change when the Cloudflare lane moves).
#   * GENERIC_SCOPE must include `roles` for the role mapping below to see the claim.
#   * GENERIC_ROLE_MAPPINGS_ROLES is a Python dict literal: LiteLLM role -> claim values.
#   * Keep UI_USERNAME / UI_PASSWORD above as the break-glass login.
#   * The client secret lives ONLY in inference/.env (gitignored).
#   * Takes effect on a RECREATE of llm-gateway-ui (hold the `inference` lease).
#GENERIC_CLIENT_ID=
#GENERIC_CLIENT_SECRET=
#GENERIC_AUTHORIZATION_ENDPOINT=https://auth.lab.example.invalid/application/o/authorize/
#GENERIC_TOKEN_ENDPOINT=https://auth.lab.example.invalid/application/o/token/
#GENERIC_USERINFO_ENDPOINT=https://auth.lab.example.invalid/application/o/userinfo/
#GENERIC_SCOPE="openid email profile roles"
#GENERIC_ROLE_MAPPINGS_ROLES="{'proxy_admin': ['admin'], 'internal_user': ['user']}"
#GENERIC_ROLE_MAPPINGS_GROUP_CLAIM=roles
#GENERIC_ROLE_MAPPINGS_DEFAULT_ROLE=internal_user_viewer
#PROXY_BASE_URL=https://lite.lab.example.invalid

# OpenRouter key for the gateway's CLOUD model group
# (inference/config/litellm/model_list/cloud.openrouter.yaml). BLANK = those
# models are not registered at all and nothing about the gateway changes -
# that is the shipped state. Read that file before setting it: llm-gateway
# sits on two internal:true networks and has NO egress today, and agent-org
# OD-6 puts the cloud lane on its own separate gateway. Setting a key here
# makes the models LISTED, not reachable.
OPENROUTER_API_KEY=

# --- Backup sidecars ---------------------------------------------------------
# *_RETAIN_COUNT / *_RETAIN_DAYS are COUNTS of most-recent archives, not a
# schedule. All backup scripts run a PRECHECK before touching any file and skip
# (with a log line) when the source is empty/missing or a TCP health probe to
# the source service fails, so a broken service never yields a torn snapshot.
#
# Spend-log backup retention (non-authoritative telemetry DB). No schedule
# variable exists: llm-gateway-backup loops on a hardcoded `sleep 86400` in its
# entrypoint (inference/compose/backups.yml:37,55).
LITELLM_BACKUP_RETAIN_DAYS=7

# GGUF model store (~110GB at present; the .lmstudio path is historical).
# Weekly cadence so two NAS slots = ~220GB max. Set LM_MODELS_BACKUP_INTERVAL=
# (empty) to DISABLE this backup if NAS storage becomes the bottleneck --
# lm-models-backup then logs DISABLED and exits
# (inference/compose/backups.yml:64, 98, 105-107).
LM_MODELS_BACKUP_RETAIN_COUNT=2
LM_MODELS_BACKUP_INTERVAL=604800
LM_MODELS_BACKUP_MIN_AGE_SECS=43200
LM_MODELS_BACKUP_HEALTH_TCP=llama-cpp-upstream:8080
