# ===========================================================================
# memory/.env.example - the MEMORY plane's own environment
# (stack-layers L.2 / D10 / D17, 2026-09-19)
# ===========================================================================
# Copy to `memory/.env` and fill in. Compose loads it NATIVELY: passing
# `-f memory/docker-compose.yml` makes `memory/` the PROJECT DIRECTORY, and
# compose reads the `.env` sitting there. No `--env-file` flag, from any
# working directory - which is why the guard in the compose file names THIS
# file.
#
# THE SPLIT RULE (D10): a variable lives in the .env of the plane whose service
# reads it. A value two planes read is DECLARED IN EACH - the plane files are
# independent and compose cannot reference one from another.
#
# WHAT IS IN HERE: exactly the variables `memory/docker-compose.yml`
# interpolates. This plane declares NO compose profiles, so there is no
# COMPOSE_PROFILES line (D17: the variable belongs to a file only where that
# plane has profiles of its own).
#
# Migrating an existing deployment: documentation/runbooks/env-split-migration.md.

# --- mnemory memory service --------------------------------------------------
# API key for MCP authentication (single key). Carries a ${...:?} fail-loud
# guard in memory/docker-compose.yml, so a bare `up` without it fails loud.
MCP_API_KEY=your-mnemory-api-key-here
# JSON dict mapping keys to user IDs: {"api-key": "user-id"}
MCP_API_KEYS=

# mnemory's LiteLLM virtual key (J.1). Issued by the INFERENCE plane's
# llm-gateway-ui /key/generate; the master key that mints it lives in
# inference/.env. This is the consumer's own copy, per D10.
MNEMORY_LLM_API_KEY=

# Keep this below the server context to preserve prompt/output headroom.
MNEMORY_LLM_CONTEXT_SIZE=131072

# --- mnemory privacy gateway (:8060) -----------------------------------------
MNEMORY_GATEWAY_KEY=
MNEMORY_CLOUD_USER=

# --- Backup sidecar ----------------------------------------------------------
# BACKUP_RETAIN_COUNT is how many MOST-RECENT archives to keep (a count, not
# days). Default 2 = ~2 nightly snapshots local; the weekly NAS sync gives you
# ~2 additional copies per NAS slot.
#
# No cron variable exists: mnemory-backup is a sleep-loop sidecar, scheduled by
# MNEMORY_BACKUP_INTERVAL seconds (memory/docker-compose.yml:111).
BACKUP_RETAIN_COUNT=2
MNEMORY_BACKUP_INTERVAL=86400
